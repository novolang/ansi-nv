// vtparse_tests.nv — the suite for the state machine.  Run with
// `--isolate` for one verdict per `@test`.
//
// These cases are about the chunk boundary.  A parser whose tests only
// ever feed whole sequences is a parser that will be split in
// production on the first day, so almost every case below feeds the
// bytes one at a time and asserts what the machine is holding in
// between.  The rest fix a limit and assert the refusal.
//
// The effect row on every `@test` here is `[io]`, which `test.case`
// needs and nothing else does.  That is the standing check that the
// parser itself is `[]`.

use std.test
use std.list
use vtparse

// The bytes of `ESC [ 2 ; 1 H`, which is CUP for row 2, column 1.  It
// is written out so that the cases below can feed any prefix of it.
fn cup_2_1() -> [Int]
    [0x1B, 0x5B, 0x32, 0x3B, 0x31, 0x48]

// Feed a whole list of bytes and hand back the last step.  That is the
// shape almost every case here wants, because it carries the action
// that fired and the parser it fired with.
fn run(bytes: [Int]) -> vtcore.AnsiParser
    var p = vtparse.parser_new()
    var last = vtparse.feed(p, 0)
    for b in bytes
        last = vtparse.feed(p, b)
        p = last
    last

@test
fn test_a_fresh_parser_is_in_the_ground_state() [io]
    let p = vtparse.parser_new()

    test.case("a new parser rests in the ground state")
    test.assert(vtparse.is_settled(p))

    test.case("and holds no parameters")
    test.assert(vtparse.param_count(p) == 0)

    test.case("and no private marker")
    test.assert(vtparse.private_marker_of(p) == vtparse.NO_PRIVATE_MARKER)

@test
fn test_a_printable_byte_comes_out_as_a_codepoint() [io]
    test.case("'A' is a print of 0x41")
    let step = run([0x41])
    match vtparse.action_of(step)
        AnsiPrint(ch) => test.assert(ch == 0x41)
        _             => test.assert(false)

    test.case("and the machine is settled again")
    test.assert(vtparse.is_settled(step))

@test
fn test_a_control_byte_comes_out_as_an_execute() [io]
    test.case("LF is an execute of 0x0A")
    let step = run([0x0A])
    match vtparse.action_of(step)
        AnsiExecute(c) => test.assert(c == 0x0A)
        _              => test.assert(false)

@test
fn test_a_csi_dispatches_on_its_final_byte() [io]
    test.case("CUP's final byte is 'H'")
    let step = run(cup_2_1())
    match vtparse.action_of(step)
        AnsiCsiDispatch(f) => test.assert(f == 0x48)
        _                  => test.assert(false)

    test.case("and its two parameters are readable off the parser it came with")
    test.assert(vtparse.param_at(step, 0, 1) == 2)
    test.assert(vtparse.param_at(step, 1, 1) == 1)

@test
fn test_a_chunk_may_split_inside_a_parameter_list() [io]
    // The case the chunk boundary is about.  Feed the sequence in two
    // halves, keep the parser across the break, and assert the same
    // dispatch.
    var p = vtparse.parser_new()
    var last = vtparse.feed(p, 0)
    for b in [0x1B, 0x5B, 0x32]
        last = vtparse.feed(p, b)
        p = last

    test.case("mid-parameter, the machine is not settled")
    test.assert(vtparse.is_settled(p) == false)

    for b in [0x3B, 0x31, 0x48]
        last = vtparse.feed(p, b)
        p = last

    test.case("and the split makes no difference to the dispatch")
    match vtparse.action_of(last)
        AnsiCsiDispatch(f) => test.assert(f == 0x48)
        _                  => test.assert(false)
    test.assert(vtparse.param_at(last, 0, 1) == 2)

@test
fn test_an_omitted_parameter_takes_the_callers_default() [io]
    test.case("`CSI H` has no parameters")
    let step = run([0x1B, 0x5B, 0x48])
    test.assert(vtparse.param_count(step) == 0)

    test.case("and the fallback is the caller's, not zero")
    test.assert(vtparse.param_at(step, 0, 1) == 1)
    test.assert(vtparse.param_at(step, 0, 0) == 0)

@test
fn test_an_empty_parameter_is_not_a_zero() [io]
    test.case("`CSI ; 5 H` has an empty first parameter")
    let step = run([0x1B, 0x5B, 0x3B, 0x35, 0x48])
    test.assert(vtparse.param_count(step) == 2)

    test.case("and the empty one takes the fallback rather than reading 0")
    test.assert(vtparse.param_at(step, 0, 1) == 1)
    test.assert(vtparse.param_at(step, 1, 1) == 5)

@test
fn test_the_private_marker_is_kept_apart_from_the_parameters() [io]
    test.case("`CSI ? 1049 h` carries the '?' as a marker")
    let step = run([0x1B, 0x5B, 0x3F, 0x31, 0x30, 0x34, 0x39, 0x68])
    test.assert(vtparse.private_marker_of(step) == 0x3F)

    test.case("and 1049 as its only parameter")
    test.assert(vtparse.param_count(step) == 1)
    test.assert(vtparse.param_at(step, 0, 0) == 1049)

    test.case("while `CSI 4 h` carries no marker at all")
    let plain = run([0x1B, 0x5B, 0x34, 0x68])
    test.assert(vtparse.private_marker_of(plain) == vtparse.NO_PRIVATE_MARKER)

@test
fn test_colon_sub_parameters_stay_in_their_group() [io]
    // `CSI 4:3 m`, a curly underline.  One parameter and two
    // sub-parameters.
    test.case("`4:3` is one parameter")
    let step = run([0x1B, 0x5B, 0x34, 0x3A, 0x33, 0x6D])
    test.assert(vtparse.param_count(step) == 1)

    test.case("with two sub-parameters, counting itself")
    test.assert(vtparse.sub_count(step, 0) == 2)
    test.assert(vtparse.sub_at(step, 0, 0, 0) == 4)
    test.assert(vtparse.sub_at(step, 0, 1, 0) == 3)

@test
fn test_an_empty_sub_parameter_slot_survives() [io]
    // `CSI 38:2::1:2:3 m`, the T.416 spelling, with an empty
    // colour-space slot that a naive split drops.
    test.case("the empty middle slot is still a slot")
    let step = run([0x1B, 0x5B, 0x33, 0x38, 0x3A, 0x32, 0x3A, 0x3A,
                    0x31, 0x3A, 0x32, 0x3A, 0x33, 0x6D])
    test.assert(vtparse.sub_count(step, 0) == 6)

    test.case("and the channels are where T.416 puts them")
    test.assert(vtparse.sub_at(step, 0, 3, 0) == 1)
    test.assert(vtparse.sub_at(step, 0, 4, 0) == 2)
    test.assert(vtparse.sub_at(step, 0, 5, 0) == 3)

@test
fn test_an_osc_payload_arrives_a_byte_at_a_time() [io]
    // `OSC 0 ; A BEL`, which sets the title to "A".
    var p = vtparse.parser_new()
    var starts = 0
    var puts = 0
    var ends = 0
    var others = 0
    for b in [0x1B, 0x5D, 0x30, 0x3B, 0x41, 0x07]
        let step = vtparse.feed(p, b)
        p = step
        match vtparse.action_of(step)
            AnsiOscStart  =>
                starts = starts + 1
            AnsiOscPut(_) =>
                puts = puts + 1
            AnsiOscEnd(_) =>
                ends = ends + 1
            _             =>
                others = others + 1

    test.case("one start, one end")
    test.assert(starts == 1)
    test.assert(ends == 1)

    test.case("and three payload bytes — the code, the semicolon, the value")
    test.assert(puts == 3)

    // Six bytes, and every one of them is accounted for.  They are the
    // ESC with nothing to do, the `]` that started the string, three
    // payload bytes, and the BEL that ended it.  The four figures have
    // to add up to the number of bytes fed.
    test.case("and the ESC was consumed with nothing to do")
    test.assert(others == 1)
    test.assert(starts + puts + ends + others == 6)

@test
fn test_the_osc_terminator_is_reported_rather_than_normalised() [io]
    test.case("a BEL-terminated string says so")
    let bel = run([0x1B, 0x5D, 0x30, 0x3B, 0x41, 0x07])
    match vtparse.action_of(bel)
        AnsiOscEnd(t) =>
            match t
                AnsiBelTerminated => test.assert(true)
                AnsiStTerminated  => test.assert(false)
        _             => test.assert(false)

    test.case("and an ST-terminated one says that instead")
    let st = run([0x1B, 0x5D, 0x30, 0x3B, 0x41, 0x1B, 0x5C])
    match vtparse.action_of(st)
        AnsiOscEnd(t) =>
            match t
                AnsiStTerminated  => test.assert(true)
                AnsiBelTerminated => test.assert(false)
        _             => test.assert(false)

@test
fn test_an_osc_payload_splits_into_fields() [io]
    // The payload of `OSC 52 ; c ; QUJD ST`, as the caller would have
    // accumulated it from `AnsiOscPut`.
    let payload = [0x35 as u8, 0x32 as u8, 0x3B as u8, 0x63 as u8,
                   0x3B as u8, 0x51 as u8, 0x55 as u8, 0x4A as u8, 0x44 as u8]

    test.case("the code is the digits before the first semicolon")
    match vtparse.osc_code(payload)
        Some(c) => test.assert(c == 52)
        None    => test.assert(false)

    test.case("and the fields count the code as field 0")
    match vtparse.osc_field(payload, 1)
        Some(f) => test.assert(list.len(f) == 1)
        None    => test.assert(false)

    test.case("with the last field returned whole")
    match vtparse.osc_field(payload, 2)
        Some(f) => test.assert(list.len(f) == 4)
        None    => test.assert(false)

    test.case("and nothing past the end")
    match vtparse.osc_field(payload, 9)
        Some(_) => test.assert(false)
        None    => test.assert(true)

    test.case("the body is everything after the first semicolon, whole")
    match vtparse.osc_body(payload)
        Some(b) => test.assert(list.len(b) == 6)
        None    => test.assert(false)

    test.case("and a payload with no semicolon has no body")
    match vtparse.osc_body([0x30 as u8, 0x31 as u8])
        Some(_) => test.assert(false)
        None    => test.assert(true)

@test
fn test_a_snapshot_keeps_an_empty_parameter_empty() [io]
    // `CSI ; 5 H`, whose first parameter is an absence rather than a
    // zero.  ECMA-48 section 5.4.2 gives an omitted parameter the
    // function's own default, so a caller has to be able to tell the
    // two apart.
    var p = vtparse.parser_new()
    for b in [0x1B, 0x5B, 0x3B, 0x35, 0x48]
        p = vtparse.feed(p, b)
    let ps = vtparse.params_of(p)

    test.case("the empty slot answers the fallback rather than zero")
    test.assert(vtparse.params_at(ps, 0, 0 - 1) == 0 - 1)
    test.assert(vtparse.params_at(ps, 0, 1) == 1)

    test.case("the parameter after it is the number that was written")
    test.assert(vtparse.params_at(ps, 1, 0) == 5)

    test.case("and the sub-parameter reader agrees with it")
    test.assert(vtparse.params_sub_at(ps, 0, 0, 0 - 1) == 0 - 1)

    test.case("a sub-parameter index that runs into the next parameter is absent")
    test.assert(vtparse.params_sub_count(ps, 0) == 1)
    test.assert(vtparse.params_sub_at(ps, 0, 1, 0 - 2) == 0 - 2)

    test.case("the parser reports the ceilings it is enforcing")
    test.assert((vtparse.limits_of(p).params_max as Int) == 16)

@test
fn test_a_multi_byte_codepoint_is_assembled_across_bytes() [io]
    // U+00E9, latin small letter e with acute, which is 0xC3 0xA9.
    var p = vtparse.parser_new()
    let first = vtparse.feed(p, 0xC3)

    test.case("the lead byte alone prints nothing")
    match vtparse.action_of(first)
        AnsiNothing => test.assert(true)
        _           => test.assert(false)

    test.case("and leaves the machine unsettled")
    test.assert(vtparse.is_settled(first) == false)

    test.case("the continuation byte completes the codepoint")
    let second = vtparse.feed(first, 0xA9)
    match vtparse.action_of(second)
        AnsiPrint(ch) => test.assert(ch == 0xE9)
        _             => test.assert(false)

@test
fn test_a_broken_codepoint_is_refused_rather_than_silently_dropped() [io]
    test.case("a lone continuation byte in the ground state is a fault")
    let step = run([0xA9])
    match vtparse.action_of(step)
        AnsiRefused(why) =>
            match why
                AnsiBadUtf8 => test.assert(true)
                _           => test.assert(false)
        _                => test.assert(false)

@test
fn test_a_parameter_list_past_the_limit_is_refused() [io]
    // `strict_limits` keeps 8 parameters, and this sequence carries
    // 10.
    var p = vtparse.parser_with(vtparse.strict_limits())
    var refused = false
    var steps = 0
    for b in [0x1B, 0x5B, 0x31, 0x3B, 0x31, 0x3B, 0x31, 0x3B, 0x31,
              0x3B, 0x31, 0x3B, 0x31, 0x3B, 0x31, 0x3B, 0x31, 0x3B,
              0x31, 0x3B, 0x31, 0x48]
        let step = vtparse.feed(p, b)
        p = step
        match vtparse.action_of(step)
            AnsiRefused(_) =>
                refused = true
            _              =>
                steps = steps + 1

    test.case("the eleventh parameter is a refusal")
    test.assert(refused)
    test.assert(steps > 0)

    test.case("and the machine is settled afterwards rather than wedged")
    test.assert(vtparse.is_settled(p))

@test
fn test_reset_forgets_a_partial_sequence() [io]
    var p = vtparse.parser_new()
    for b in [0x1B, 0x5B, 0x32]
        let step = vtparse.feed(p, b)
        p = step

    test.case("mid-sequence, the machine is not settled")
    test.assert(vtparse.is_settled(p) == false)

    test.case("and a reset puts it back in the ground state")
    test.assert(vtparse.is_settled(vtparse.reset(p)))

@test
fn test_the_chunk_path_pairs_every_action_with_its_parameters() [io]
    let drained = vtparse.drain(vtparse.parser_new(), [0x1B as u8, 0x5B as u8,
                                                      0x32 as u8, 0x3B as u8,
                                                      0x31 as u8, 0x48 as u8])

    test.case("one dispatch came out of the chunk")
    test.assert(list.len(drained.calls) == 1)

    test.case("and its parameters travelled with it")
    let call = list.get(drained.calls, 0)
    test.assert(vtparse.params_at(call.params, 0, 1) == 2)
    test.assert(vtparse.params_at(call.params, 1, 1) == 1)
