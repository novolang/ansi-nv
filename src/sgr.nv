// sgr.nv — what a cell looks like, and the arithmetic that turns a
// `CSI m` into it and back.
//
// SGR is the one part of the escape-sequence layer that is a model
// rather than a command.  `CSI 1 m` does not do anything, it changes
// what the next character will look like.  This module is therefore a
// struct of what a cell can be, a fold of parameters onto it, and the
// inverse of that fold.  The inverse is the half most implementations
// leave out.  Given the attributes a terminal is currently in and the
// ones it should be in, it answers the shortest parameter list that
// gets there.  A renderer that emits a full reset before every cell
// works and is four times the bytes.
//
// The three colour forms are one type.  `AnsiColor` covers the 16 named
// colours as indices 0..15, the 256-colour cube, 24-bit RGB, and
// whatever the terminal's default is.  A cell holds exactly one of the
// four, and code that branched on which form it was would branch in
// every function that touches a colour.  What differs between the forms
// is how they serialise, which is `color_params`' question and nobody
// else's.
//
// A palette is deliberately not here.  Indices 0..15 are the terminal's
// own sixteen and no library can know what they are, because a user's
// theme decides.  `indexed_to_rgb` therefore answers for 16..255, where
// the values are fixed by the specification, and answers `None` below
// that.  A caller that wants the low sixteen supplies them, which is a
// configuration rather than arithmetic.

use vtparse

// AnsiColor is one cell's foreground, background or underline colour.
//
// `AnsiIndexed` covers both the named sixteen (0..15) and the
// 256-colour cube (16..255), because on the wire they are the same
// field and separating them would make every consumer join them back
// up.
pub enum AnsiColor
    // Whatever the terminal was configured with, which is SGR 39, 49
    // and 59.  It is not a colour this package can name.  A renderer
    // that resolved it to a concrete RGB would stop tracking a theme
    // change.
    AnsiDefaultColor
    // A palette index, 0..255.  0..7 are the named colours, 8..15
    // their bright forms, 16..231 the 6x6x6 cube, 232..255 the greys.
    AnsiIndexed(index: Int)
    // 24-bit colour, each channel 0..255.
    AnsiTrueColor(r: Int, g: Int, b: Int)

// SgrUnderline is which of the underline styles a cell carries.
//
// It is a separate type from the boolean flags because the five styles
// are mutually exclusive.  SGR `4:3` replaces `4:1` rather than adding
// to it, and a `Bool` here is what makes a terminal draw a straight
// line under a spelling mistake.
pub enum SgrUnderline
    SgrNoUnderline
    // SGR 4, or 4:1.
    SgrSingleUnderline
    // SGR 21, or 4:2.  21 is also read as "bold off" by some
    // terminals, which is why 4:2 exists and why this package emits
    // 4:2.
    SgrDoubleUnderline
    // SGR 4:3.  What a spell checker uses.
    SgrCurlyUnderline
    // SGR 4:4.
    SgrDottedUnderline
    // SGR 4:5.
    SgrDashedUnderline

// SgrRgb is a colour resolved to its three channels.
//
// The return of `indexed_to_rgb`, and nothing else uses it.  A cell
// holds an `AnsiColor` rather than this.
pub struct SgrRgb
    r: Int
    g: Int
    b: Int

// SgrAttrs is everything SGR can say about one cell.
//
// A flat struct of flags rather than a packed integer.  novo-vte packs
// the same information into two 64-bit words and pays for it in every
// accessor, which is right for a grid of a hundred thousand cells and
// wrong for a published surface where the field name is the
// documentation.  A consumer that needs the packing writes it over
// this.
pub struct SgrAttrs
    fg: AnsiColor
    bg: AnsiColor
    // SGR 58 and 59.  The colour of the underline, independent of the
    // foreground.  Terminals that do not support it ignore it, which is
    // why it is a colour rather than an option.
    underline_color: AnsiColor
    // SGR 1.  Separate from `dim`, because SGR 22 clears both and 1
    // and 2 can both be set.
    bold: Bool
    // SGR 2.
    dim: Bool
    // SGR 3.
    italic: Bool
    underline: SgrUnderline
    // SGR 5 and 6 folded into one flag.  No terminal in use
    // distinguishes slow from rapid blink, and a program that asked for
    // rapid got slow.
    blink: Bool
    // SGR 7.  Swap foreground and background at draw time.  It is kept
    // as a flag rather than applied to the two colours, because SGR 27
    // has to be able to undo it.
    inverse: Bool
    // SGR 8.  Drawn as the background colour.
    hidden: Bool
    // SGR 9.
    strike: Bool
    // SGR 53.
    overline: Bool

// ── Building an attribute set ───────────────────────────────────────
//
// One setter per field.  `attrs_default` is the terminal's own state
// and every other set of attributes is built from it, because the
// fields are not `var` and a literal written outside this module would
// have to name all twelve.
//
// Each setter returns a fresh literal.  `SgrAttrs` is a plain struct,
// which is a reference type (SPEC section 4.1), so a field store is
// seen through every binding that names the same attributes — the
// caller's included — and a renderer whose previous style became the
// new one would emit no transitions at all.  None of the fields is
// `var`, so the compiler refuses the store outright (E2034); the
// literal is the spelling a value-returning function has anyway.

// set_fg is `a` with the foreground colour given.  SGR 30 to 37, 90 to
// 97, 38 and 39 all land here.
//
// ```novo
// use sgr
//
// fn main() [io]
//     let a = sgr.set_fg(sgr.attrs_default(), AnsiIndexed(1))
//     match a.fg
//         AnsiIndexed(i) => println("${i}")   // 1
//         _              => println("not indexed")
// ```
pub fn set_fg(a: SgrAttrs, c: AnsiColor) -> SgrAttrs
    SgrAttrs { fg: c, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike,
               overline: a.overline }

// set_bg is `a` with the background colour given.  SGR 40 to 47, 100 to
// 107, 48 and 49 all land here.
//
// ```novo
// use sgr
//
// fn main() [io]
//     let a = sgr.set_bg(sgr.attrs_default(), AnsiTrueColor(10, 20, 30))
//     match a.bg
//         AnsiTrueColor(r, _, _) => println("${r}")   // 10
//         _                      => println("not true colour")
// ```
pub fn set_bg(a: SgrAttrs, c: AnsiColor) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: c, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike,
               overline: a.overline }

// set_underline_color is `a` with the underline colour given, which is
// SGR 58 and 59.  It is independent of the foreground, and a terminal
// without the extension ignores it.
//
// ```novo
// use sgr
//
// fn main() [io]
//     let a = sgr.set_underline_color(sgr.attrs_default(), AnsiIndexed(9))
//     match a.underline_color
//         AnsiIndexed(i) => println("${i}")   // 9
//         _              => println("not indexed")
// ```
pub fn set_underline_color(a: SgrAttrs, c: AnsiColor) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: c, bold: a.bold, dim: a.dim,
               italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike,
               overline: a.overline }

// set_bold is `a` with SGR 1 on or off.
//
// ```novo
// use sgr
//
// fn main() [io]
//     println("${sgr.set_bold(sgr.attrs_default(), true).bold}")   // true
// ```
pub fn set_bold(a: SgrAttrs, v: Bool) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: v,
               dim: a.dim, italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike,
               overline: a.overline }

// set_dim is `a` with SGR 2 on or off.  It is separate from `bold`,
// because SGR 22 clears both and a cell may carry either.
//
// ```novo
// use sgr
//
// fn main() [io]
//     println("${sgr.set_dim(sgr.attrs_default(), true).dim}")   // true
// ```
pub fn set_dim(a: SgrAttrs, v: Bool) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: v, italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike,
               overline: a.overline }

// set_italic is `a` with SGR 3 on or off.
//
// ```novo
// use sgr
//
// fn main() [io]
//     println("${sgr.set_italic(sgr.attrs_default(), true).italic}")   // true
// ```
pub fn set_italic(a: SgrAttrs, v: Bool) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: v, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike,
               overline: a.overline }

// set_underline is `a` with the underline style given.  The five styles
// are mutually exclusive, so this replaces rather than adds.
//
// ```novo
// use sgr
//
// fn main() [io]
//     let a = sgr.set_underline(sgr.attrs_default(), SgrCurlyUnderline)
//     match a.underline
//         SgrCurlyUnderline => println("curly")
//         _                 => println("something else")
// ```
pub fn set_underline(a: SgrAttrs, u: SgrUnderline) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: a.italic, underline: u, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike,
               overline: a.overline }

// set_blink is `a` with SGR 5 or 6 on or off.  The two are one flag
// here, because no terminal in use distinguishes slow from rapid.
//
// ```novo
// use sgr
//
// fn main() [io]
//     println("${sgr.set_blink(sgr.attrs_default(), true).blink}")   // true
// ```
pub fn set_blink(a: SgrAttrs, v: Bool) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: a.italic, underline: a.underline, blink: v,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike,
               overline: a.overline }

// set_inverse is `a` with SGR 7 on or off.  It is kept as a flag rather
// than applied to the two colours, because SGR 27 has to be able to
// undo it.
//
// ```novo
// use sgr
//
// fn main() [io]
//     println("${sgr.set_inverse(sgr.attrs_default(), true).inverse}")   // true
// ```
pub fn set_inverse(a: SgrAttrs, v: Bool) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: v, hidden: a.hidden, strike: a.strike, overline: a.overline }

// set_hidden is `a` with SGR 8 on or off.  A hidden cell is drawn in
// the background colour.
//
// ```novo
// use sgr
//
// fn main() [io]
//     println("${sgr.set_hidden(sgr.attrs_default(), true).hidden}")   // true
// ```
pub fn set_hidden(a: SgrAttrs, v: Bool) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: v, strike: a.strike, overline: a.overline }

// set_strike is `a` with SGR 9 on or off.
//
// ```novo
// use sgr
//
// fn main() [io]
//     println("${sgr.set_strike(sgr.attrs_default(), true).strike}")   // true
// ```
pub fn set_strike(a: SgrAttrs, v: Bool) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: v, overline: a.overline }

// set_overline is `a` with SGR 53 on or off.
//
// ```novo
// use sgr
//
// fn main() [io]
//     println("${sgr.set_overline(sgr.attrs_default(), true).overline}")   // true
// ```
pub fn set_overline(a: SgrAttrs, v: Bool) -> SgrAttrs
    SgrAttrs { fg: a.fg, bg: a.bg, underline_color: a.underline_color, bold: a.bold,
               dim: a.dim, italic: a.italic, underline: a.underline, blink: a.blink,
               inverse: a.inverse, hidden: a.hidden, strike: a.strike, overline: v }

// ── Small arithmetic ────────────────────────────────────────────────

// A channel or an index, held inside 0..255.  A malformed value paints
// something rather than being refused, which is what novo-vte's parser
// did and what a terminal does.
fn clamp_byte(n: Int) -> Int
    if n < 0
        0
    else if n > 255
        255
    else
        n

// The six levels of the 6x6x6 cube.  They are 0, then 95 and up in
// steps of 40.
fn cube_level(n: Int) -> Int
    if n == 0
        0
    else
        55 + n * 40

// The RGB behind a palette index at or above 16, without the optional.
//
// `indexed_to_rgb` is this with the range check in front of it.
// `nearest_index` and `downgrade` call this directly, so neither of
// them carries a `None` arm that no argument can reach.
fn cube_rgb(index: Int) -> SgrRgb
    if index < 232
        let i = index - 16
        SgrRgb { r: cube_level(i / 36), g: cube_level(i / 6 % 6), b: cube_level(i % 6) }
    else
        let v = 8 + (index - 232) * 10
        SgrRgb { r: v, g: v, b: v }

// The nearest of the sixteen a terminal owns, by the classic three
// bits plus a brightness bit.
//
// It is not a palette lookup and cannot be one, because indices 0..15
// are the user's theme and no library knows their RGB.  What it knows
// is what the bits mean.  Bit 0 is red, bit 1 green, bit 2 blue and
// bit 3 bright, so the answer is derived from the channel values rather
// than matched against colours this package would have to invent.
fn basic_index(r: Int, g: Int, b: Int) -> Int
    var n = 0
    if r >= 128
        n = n + 1
    if g >= 128
        n = n + 2
    if b >= 128
        n = n + 4
    if r >= 192 or g >= 192 or b >= 192
        n = n + 8
    n

// The style a `4:<n>` sub-parameter names.  An unknown one is a plain
// underline rather than nothing, so that a terminal which grows a sixth
// style is still underlined by a program that has not heard of it.
fn underline_of(n: Int) -> SgrUnderline
    if n == 0
        SgrNoUnderline
    else if n == 2
        SgrDoubleUnderline
    else if n == 3
        SgrCurlyUnderline
    else if n == 4
        SgrDottedUnderline
    else if n == 5
        SgrDashedUnderline
    else
        SgrSingleUnderline

// The sub-parameter `4:<n>` a style is written with, and -1 for the
// two styles that have a parameter of their own.
fn underline_sub(u: SgrUnderline) -> Int
    match u
        SgrNoUnderline     => 0 - 1
        SgrSingleUnderline => 0 - 1
        SgrDoubleUnderline => 2
        SgrCurlyUnderline  => 3
        SgrDottedUnderline => 4
        SgrDashedUnderline => 5

// ── Building a parameter list with its colon groups ─────────────────
//
// `sgr_transition` and `sgr_full` answer `[Int]`, which is a list of
// semicolon-separated parameters and has nowhere to put a colon.  Three
// of the five underline styles exist only in the colon form, as ITU-T
// T.416 § 13.1.8 defines it and xterm and kitty spell it.  They are
// curly, dotted and dashed, and the flat answer cannot carry them.
//
// The two functions therefore build an `AnsiParams`, which is the
// parser's own flat values-and-groups pair, and the `[Int]` pair is
// that flattened to one entry per group and its first value.  A group
// that was `4:3` flattens to `4`, a plain underline, which is what a
// terminal without the extension would have drawn.  `sgr_transition_sub`
// and `sgr_full_sub` are the unflattened answers, and
// `seqwrite.csi_params` is what puts one on the wire.

// The group number the next parameter opens.
fn next_group(groups: [Int]) -> Int
    if list.len(groups) == 0
        0
    else
        list.get(groups, list.len(groups) - 1) + 1

// One parameter with no sub-parameters, appended to the caller's pair
// of lists.
fn one(var values: [Int], var groups: [Int], v: Int)
    let g = next_group(groups)
    list.push(values, v)
    list.push(groups, g)

// Every entry of `vs` as its own parameter.
fn many(var values: [Int], var groups: [Int], vs: [Int])
    for v in vs
        one(values, groups, v)

// One parameter carrying one sub-parameter, as in `4:3` and its
// family.  Both values join the same group.
fn one_sub(var values: [Int], var groups: [Int], v: Int, sub: Int)
    let g = next_group(groups)
    list.push(values, v)
    list.push(values, sub)
    list.push(groups, g)
    list.push(groups, g)

// The parameters an underline style is written with.
fn underline_params(var values: [Int], var groups: [Int], u: SgrUnderline)
    let sub = underline_sub(u)
    match u
        SgrNoUnderline     => one(values, groups, 24)
        SgrSingleUnderline => one(values, groups, 4)
        _                  => one_sub(values, groups, 4, sub)

// One entry per group, which is what the `[Int]` shape can hold.
//
// An explicit loop rather than `list.map` over `list.range`.  The
// shorter spelling would stop this package building for wasm, because
// `list.range` is refused there, and a terminal emulator in a browser
// is a reader this package is `core` for.
fn flatten(ps: vtparse.AnsiParams) -> [Int]
    var out: [Int] = []
    for i in 0..vtparse.params_count(ps)
        let v = vtparse.params_at(ps, i, 0)
        out = list.push(out, v)
    out

// The parameters that build `a` from a terminal in an unknown state.
fn full_params(a: SgrAttrs) -> vtparse.AnsiParams
    var v: [Int] = []
    var g: [Int] = []
    one(v, g, 0)
    if a.bold
        one(v, g, 1)
    if a.dim
        one(v, g, 2)
    if a.italic
        one(v, g, 3)
    if same_underline(a.underline, SgrNoUnderline) == false
        underline_params(v, g, a.underline)
    if a.blink
        one(v, g, 5)
    if a.inverse
        one(v, g, 7)
    if a.hidden
        one(v, g, 8)
    if a.strike
        one(v, g, 9)
    if a.overline
        one(v, g, 53)
    if is_default_color(a.fg) == false
        many(v, g, color_params(a.fg, false, false))
    if is_default_color(a.bg) == false
        many(v, g, color_params(a.bg, true, false))
    if is_default_color(a.underline_color) == false
        many(v, g, color_params(a.underline_color, false, true))
    AnsiParams { values: v, groups: g, intermediates: [],
                 private_marker: vtparse.NO_PRIVATE_MARKER }

// The parameters that take a terminal from `from` to `to` one change
// at a time, with no reset.
fn step_params(from: SgrAttrs, to: SgrAttrs) -> vtparse.AnsiParams
    var v: [Int] = []
    var g: [Int] = []
    // 22 clears bold and dim together, so a clear of either is one
    // parameter plus whichever of the two survives it.
    if from.bold and to.bold == false or from.dim and to.dim == false
        one(v, g, 22)
        if to.bold
            one(v, g, 1)
        if to.dim
            one(v, g, 2)
    else
        if to.bold and from.bold == false
            one(v, g, 1)
        if to.dim and from.dim == false
            one(v, g, 2)
    if to.italic != from.italic
        let code_it = if to.italic
            3
        else
            23
        one(v, g, code_it)
    if same_underline(to.underline, from.underline) == false
        underline_params(v, g, to.underline)
    if to.blink != from.blink
        let code_bl = if to.blink
            5
        else
            25
        one(v, g, code_bl)
    if to.inverse != from.inverse
        let code_iv = if to.inverse
            7
        else
            27
        one(v, g, code_iv)
    if to.hidden != from.hidden
        let code_hd = if to.hidden
            8
        else
            28
        one(v, g, code_hd)
    if to.strike != from.strike
        let code_st = if to.strike
            9
        else
            29
        one(v, g, code_st)
    if to.overline != from.overline
        let code_ov = if to.overline
            53
        else
            55
        one(v, g, code_ov)
    if same_color(to.fg, from.fg) == false
        many(v, g, color_params(to.fg, false, false))
    if same_color(to.bg, from.bg) == false
        many(v, g, color_params(to.bg, true, false))
    if same_color(to.underline_color, from.underline_color) == false
        many(v, g, color_params(to.underline_color, false, true))
    AnsiParams { values: v, groups: g, intermediates: [],
                 private_marker: vtparse.NO_PRIVATE_MARKER }

// Whether a colour is the terminal's own.
fn is_default_color(c: AnsiColor) -> Bool
    match c
        AnsiDefaultColor => true
        _                => false

// Two colours, compared by value.
fn same_color(a: AnsiColor, b: AnsiColor) -> Bool
    a == b

// Two underline styles, compared by value.
fn same_underline(a: SgrUnderline, b: SgrUnderline) -> Bool
    a == b

// The colour a 38, 48 or 58 sets, put in the right field.
fn with_role_color(a: SgrAttrs, code: Int, c: AnsiColor) -> SgrAttrs
    if code == 38
        set_fg(a, c)
    else if code == 48
        set_bg(a, c)
    else
        set_underline_color(a, c)

// `38:5:N` and `38:2::R:G:B`, the whole colour inside one parameter.
fn read_colon_color(params: vtparse.AnsiParams, at: Int) -> ?SgrColorRead
    let n = vtparse.params_sub_count(params, at)
    let space = vtparse.params_sub_at(params, at, 1, 0 - 1)
    if space == 5 and n >= 3
        Some(SgrColorRead { color: AnsiIndexed(clamp_byte(vtparse.params_sub_at(params, at, 2, 0))),
                            consumed: 1 })
    else if space == 2 and n >= 6
        // T.416's own spelling, with the empty colour-space slot.
        Some(SgrColorRead { color: AnsiTrueColor(clamp_byte(vtparse.params_sub_at(params, at, 3, 0)),
                                                 clamp_byte(vtparse.params_sub_at(params, at, 4, 0)),
                                                 clamp_byte(vtparse.params_sub_at(params, at, 5, 0))),
                            consumed: 1 })
    else if space == 2 and n == 5
        // The shorter colon form terminals also accept.
        Some(SgrColorRead { color: AnsiTrueColor(clamp_byte(vtparse.params_sub_at(params, at, 2, 0)),
                                                 clamp_byte(vtparse.params_sub_at(params, at, 3, 0)),
                                                 clamp_byte(vtparse.params_sub_at(params, at, 4, 0))),
                            consumed: 1 })
    else
        None

// `38;5;N` and `38;2;R;G;B`, the colour spread over several
// parameters.
fn read_semi_color(params: vtparse.AnsiParams, at: Int) -> ?SgrColorRead
    let n = vtparse.params_count(params)
    let space = vtparse.params_at(params, at + 1, 0 - 1)
    if space == 5 and at + 2 < n
        Some(SgrColorRead { color: AnsiIndexed(clamp_byte(vtparse.params_at(params, at + 2, 0))),
                            consumed: 3 })
    else if space == 2 and at + 4 < n
        Some(SgrColorRead { color: AnsiTrueColor(clamp_byte(vtparse.params_at(params, at + 2, 0)),
                                                 clamp_byte(vtparse.params_at(params, at + 3, 0)),
                                                 clamp_byte(vtparse.params_at(params, at + 4, 0))),
                            consumed: 5 })
    else
        None

// attrs_default is a cell with the terminal's own colours and no
// styling, which is what SGR 0 resets to.
pub fn attrs_default() -> SgrAttrs
    SgrAttrs { fg: AnsiDefaultColor, bg: AnsiDefaultColor,
               underline_color: AnsiDefaultColor, bold: false, dim: false, italic: false,
               underline: SgrNoUnderline, blink: false, inverse: false, hidden: false,
               strike: false, overline: false }

// attrs_eq says whether two attribute sets would render identically.
//
// A renderer calls it to decide whether a cell needs a transition at
// all, which is the largest saving in a screen update.  Most runs of
// cells share their attributes.
pub fn attrs_eq(a: SgrAttrs, b: SgrAttrs) -> Bool
    a == b

// apply_sgr folds a whole `CSI m` parameter list onto an attribute
// set.
//
// The parameter list is taken as one value rather than one number at a
// time, because SGR is not a list of independent settings.  38 and 48
// consume the parameters after them, in either the semicolon form
// `38;2;R;G;B` or the colon form `38:2::R:G:B`, and a fold that saw one
// number at a time could not tell a colour's blue channel from a
// request for italics.
//
// An empty parameter list means SGR 0, because `CSI m` is a reset.
// That is the case a `for` loop over an empty list gets wrong.
//
// ```novo
// use vtparse
// use sgr
//
// fn main() [io]
//     let a = sgr.apply_sgr(sgr.attrs_default(), vtparse.params_empty())
//     if a.bold
//         println("bold")
//     else
//         println("an empty parameter list is a reset")
// ```
pub fn apply_sgr(a: SgrAttrs, params: vtparse.AnsiParams) -> SgrAttrs
    let n = vtparse.params_count(params)
    if n == 0
        attrs_default()
    else
        var acc = a
        // How many parameters after this one the last colour took.
        // 38, 48 and 58 consume what follows them, so a walk that read
        // one number at a time could not tell a blue channel from a
        // request for italics.
        var eaten = 0
        for i in 0..n
            if eaten > 0
                eaten = eaten - 1
            else
                let code = vtparse.params_at(params, i, 0)
                if code == 38 or code == 48 or code == 58
                    match read_extended_color(params, i)
                        Some(read) =>
                            acc = with_role_color(acc, code, read.color)
                            eaten = read.consumed - 1
                        None       =>
                            eaten = 0
                else if code == 4 and vtparse.params_sub_count(params, i) > 1
                    acc = set_underline(acc,
                                        underline_of(vtparse.params_sub_at(params, i, 1, 1)))
                else
                    acc = apply_sgr_one(acc, code)
        acc

// apply_sgr_one folds one SGR number that takes no arguments onto an
// attribute set.
//
// For a caller that has its own parameter walk and only wants the
// meaning of a single number.  It cannot express 38, 48 or 58, which
// consume what follows them.  Those three answer the attributes
// unchanged, and `apply_sgr` is the entry point that handles them.
pub fn apply_sgr_one(a: SgrAttrs, code: Int) -> SgrAttrs
    if code == 0
        attrs_default()
    else if code == 1
        set_bold(a, true)
    else if code == 2
        set_dim(a, true)
    else if code == 3
        set_italic(a, true)
    else if code == 4
        set_underline(a, SgrSingleUnderline)
    else if code == 5 or code == 6
        set_blink(a, true)
    else if code == 7
        set_inverse(a, true)
    else if code == 8
        set_hidden(a, true)
    else if code == 9
        set_strike(a, true)
    else if code == 21
        set_underline(a, SgrDoubleUnderline)
    else if code == 22
        set_dim(set_bold(a, false), false)
    else if code == 23
        set_italic(a, false)
    else if code == 24
        set_underline(a, SgrNoUnderline)
    else if code == 25
        set_blink(a, false)
    else if code == 27
        set_inverse(a, false)
    else if code == 28
        set_hidden(a, false)
    else if code == 29
        set_strike(a, false)
    else if code >= 30 and code <= 37
        set_fg(a, AnsiIndexed(code - 30))
    else if code == 39
        set_fg(a, AnsiDefaultColor)
    else if code >= 40 and code <= 47
        set_bg(a, AnsiIndexed(code - 40))
    else if code == 49
        set_bg(a, AnsiDefaultColor)
    else if code == 53
        set_overline(a, true)
    else if code == 55
        set_overline(a, false)
    else if code == 59
        set_underline_color(a, AnsiDefaultColor)
    else if code >= 90 and code <= 97
        set_fg(a, AnsiIndexed(code - 90 + 8))
    else if code >= 100 and code <= 107
        set_bg(a, AnsiIndexed(code - 100 + 8))
    else
        a

// SgrColorRead is a colour read out of a parameter list, and how many
// parameters it took.
//
// The count is the reason this is a struct.  `38;2;1;2;3` and
// `38:2::1:2:3` are the same colour and consume a different number of
// parameters, so a caller that assumed either would mis-read the rest
// of the sequence.
pub struct SgrColorRead
    color: AnsiColor
    // How many entries of the parameter list the colour occupied,
    // counting the 38, 48 or 58 that introduced it.
    consumed: Int

// read_extended_color reads a 38, 48 or 58 colour beginning at
// parameter `at`.
//
// `None` when the parameters at that position are not an extended
// colour, such as a truncated `38;2;1` or an unknown colour space.
// Both spellings are accepted.  They are the semicolon form xterm
// shipped and the colon form ITU-T T.416 defines, including the empty
// colour-space slot in `38:2::R:G:B`.
pub fn read_extended_color(params: vtparse.AnsiParams, at: Int) -> ?SgrColorRead
    let code = vtparse.params_at(params, at, 0)
    if code != 38 and code != 48 and code != 58
        None
    else if vtparse.params_sub_count(params, at) > 1
        read_colon_color(params, at)
    else
        read_semi_color(params, at)

// sgr_transition is the shortest parameter list that takes a terminal
// from one attribute set to another.
//
// The half of SGR that makes a screen update cheap, and the half most
// implementations skip.  It emits a reset only when one is shorter than
// the individual clears.  Turning off bold, italic and a colour is
// three parameters, and a reset plus the four that survive is five.
//
// It answers the parameters rather than the bytes.  `seqwrite.sgr` puts
// them on the wire, and a caller building its own sequence may want the
// numbers.
pub fn sgr_transition(from: SgrAttrs, to: SgrAttrs) -> [Int]
    flatten(sgr_transition_sub(from, to))

// sgr_full is the parameter list that produces an attribute set from
// scratch, beginning with the 0 that resets.
//
// What a renderer emits at the start of a line it is redrawing whole,
// where the terminal's current attributes are unknown.
pub fn sgr_full(a: SgrAttrs) -> [Int]
    flatten(sgr_full_sub(a))

// sgr_transition_sub is `sgr_transition` with the colon groups intact.
//
// `[Int]` is a list of semicolon-separated parameters, and three of the
// five underline styles have no spelling without a colon (ITU-T T.416
// § 13.1.8).  They are curly, dotted and dashed, so the flat shape
// cannot express them.  This answers the parser's own `AnsiParams`,
// whose flat values-and-groups pair can, and `seqwrite.csi_params`
// writes it.  `sgr_transition` is this flattened to one entry per
// group, so a `4:3` becomes a plain `4`.
//
// ```novo
// use sgr
// use seqwrite
//
// fn main() [io]
//     let plain = sgr.attrs_default()
//     let curly = sgr.apply_sgr_one(plain, 4)
//     let out = seqwrite.csi_params([], sgr.sgr_transition_sub(plain, curly), 0x6D)
//     println("${list.len(out)}")
// ```
pub fn sgr_transition_sub(from: SgrAttrs, to: SgrAttrs) -> vtparse.AnsiParams
    if attrs_eq(from, to)
        vtparse.params_empty()
    else
        let stepwise = step_params(from, to)
        let whole = full_params(to)
        if vtparse.params_count(stepwise) <= vtparse.params_count(whole)
            stepwise
        else
            whole

// sgr_full_sub is `sgr_full` with the colon groups intact.
//
// It stands beside `sgr_full` for the reason `sgr_transition_sub`
// stands beside `sgr_transition`, and `sgr_full` is this flattened.
pub fn sgr_full_sub(a: SgrAttrs) -> vtparse.AnsiParams
    full_params(a)

// color_params is the parameters one colour serialises to, in the
// given role.
//
// `is_background` picks between the 3x and 4x families, and the
// underline colour has a family of its own in 58 and 59.  The three
// roles share one function because they differ by a constant.
pub fn color_params(c: AnsiColor, is_background: Bool, is_underline: Bool) -> [Int]
    let extended = if is_underline
        58
    else if is_background
        48
    else
        38
    match c
        AnsiDefaultColor       =>
            if is_underline
                [59]
            else if is_background
                [49]
            else
                [39]
        AnsiIndexed(index)     =>
            let i = clamp_byte(index)
            if is_underline == false and i < 8
                if is_background
                    [40 + i]
                else
                    [30 + i]
            else if is_underline == false and i < 16
                if is_background
                    [100 + i - 8]
                else
                    [90 + i - 8]
            else
                [extended, 5, i]
        AnsiTrueColor(r, g, b) =>
            [extended, 2, clamp_byte(r), clamp_byte(g), clamp_byte(b)]

// indexed_to_rgb is the RGB a palette index above 15 stands for.
//
// `None` for 0..15 and for anything outside 0..255.  The low sixteen
// are the terminal's own and a library cannot know them.  16..231 are
// the 6x6x6 cube with the levels 0, 95, 135, 175, 215 and 255, and
// 232..255 are the 24 greys from 8 to 238 in steps of 10.  Those two
// tables are fixed by the specification, which is why this function can
// exist and why the low sixteen are not part of it.
pub fn indexed_to_rgb(index: Int) -> ?SgrRgb
    if index < 16 or index > 255
        None
    else
        Some(cube_rgb(index))

// nearest_index is the palette index above 15 that is closest to an
// RGB value.
//
// For a renderer that has 24-bit colours and a terminal that has 256.
// It searches the cube and the greys and takes whichever is closer in
// squared distance.  That is what every terminal multiplexer does, and
// it is what makes a downgraded colour look like the colour rather than
// like a neighbour.
pub fn nearest_index(c: SgrRgb) -> Int
    var best = 16
    var best_d = 0 - 1
    for i in 16..256
        let v = cube_rgb(i)
        let dr = v.r - c.r
        let dg = v.g - c.g
        let db = v.b - c.b
        let d = dr * dr + dg * dg + db * db
        if best_d < 0 or d < best_d
            best = i
            best_d = d
    best

// downgrade reduces a colour to what a terminal of the given depth can
// show.
//
// The three depths are the three answers `TERM` and `COLORTERM` give.
// Asking for one this terminal cannot render is how a program ends up
// printing the parameters as text on a terminal that ignored them.
// Which depth is available is a question about the environment, which a
// `core` package may not read, so the answer arrives here as an
// argument.
pub fn downgrade(c: AnsiColor, depth: SgrDepth) -> AnsiColor
    match depth
        SgrNoColor   => AnsiDefaultColor
        SgrDepth16   =>
            match c
                AnsiDefaultColor       => c
                AnsiIndexed(index)     =>
                    if index < 16
                        c
                    else
                        let v = cube_rgb(clamp_byte(index))
                        AnsiIndexed(basic_index(v.r, v.g, v.b))
                AnsiTrueColor(r, g, b) => AnsiIndexed(basic_index(r, g, b))
        SgrDepth256  =>
            match c
                AnsiTrueColor(r, g, b) =>
                    AnsiIndexed(nearest_index(SgrRgb { r: r, g: g, b: b }))
                _                      => c
        SgrDepthTrue => c

// SgrDepth is how many colours the terminal on the other end can
// actually show.
pub enum SgrDepth
    // No colour at all.  Every colour becomes `AnsiDefaultColor`, and
    // `inverse` is what is left to distinguish anything with.
    SgrNoColor
    // The named sixteen.
    SgrDepth16
    // The 256-colour cube.
    SgrDepth256
    // 24-bit.
    SgrDepthTrue
