// vtquery.nv — the questions a program asks a terminal, and the
// answers read back off the parser.
//
// Every body here is a `todo()`; the signatures are the design.
//
// A QUERY IS TWO HALVES AND A DEADLOCK.  A program writes `CSI 6 n`
// and the terminal writes `CSI <row> ; <col> R` back — on the INPUT
// stream, mixed in with whatever the user is typing.  So the two
// halves live in different places: `write_query` builds the question
// into the caller's buffer, and `reply_of` reads the answer out of a
// CSI dispatch the ordinary parser produced.  Nothing here waits, and
// nothing here reads, because a `core` package cannot do either and
// because the caller is the only party that knows what to do when the
// answer never comes.
//
// THE ANSWER MAY NEVER COME, and that is the interface's real subject.
// A terminal that does not implement a query does not say so — it
// stays silent, and a program that blocked on the reply hangs.  Every
// consumer therefore needs a timeout, and the timeout is the host's:
// this package's contribution is that a reply is RECOGNISABLE when it
// arrives, so the host's read loop can hand every dispatch here and
// act on the ones that are answers.
//
// WHY IT IS NOT IN keymap-nv.  A reply arrives on the same stream as
// the keys and looks exactly like one — `CSI 1 ; 1 R` is a reply and
// `CSI 1 ; 5 R` is not a key but could be mistaken for one by a
// decoder that had never heard of DSR.  Both packages therefore have
// to know the shape.  It lives here because a reply is a terminal's
// answer to something this package's writer asked, and keymap-nv
// reports an unrecognised CSI rather than guessing.

use vtparse
use seqwrite

// AnsiQuery is something a program can ask the terminal.
//
// Only the queries with a defined, parseable answer are here.  A
// terminal has dozens more; the ones whose replies are free-form
// strings belong to whoever is parsing that string, and `seqwrite.csi`
// is how they get asked.
pub enum AnsiQuery
    // DSR 6, `CSI 6 n` — where is the cursor?  The one query almost
    // every terminal answers, and the one a program uses to find the
    // window size when it has no other way to ask.
    AnsiCursorPositionQuery
    // DSR 5, `CSI 5 n` — are you there?  A terminal answers
    // `CSI 0 n`, and the value is that a program can tell a live
    // terminal from a pipe without a system call.
    AnsiDeviceStatusQuery
    // Primary DA, `CSI c` — what are you?  The answer names the
    // terminal class and its options.
    AnsiDeviceAttributesQuery
    // Secondary DA, `CSI > c` — what version are you?  How a program
    // tells one emulator from another when it has to.
    AnsiSecondaryAttributesQuery
    // `CSI 1 8 t` — how many rows and columns is the text area?  A
    // fallback for a program with no `TIOCGWINSZ`, and the answer a
    // terminal multiplexer sometimes gets wrong.
    AnsiTextAreaSizeQuery
    // DECRQM, `CSI ? <mode> $ p` — is this mode set?  The only
    // reliable way to ask whether a terminal supports synchronised
    // output before using it.
    AnsiModeQuery(mode: seqwrite.AnsiMode)

// AnsiModeSetting is DECRPM's five answers.
//
// "Not recognised" and "reset" are different answers and a program
// that folded them would enable a feature the terminal has never heard
// of: an unrecognised mode reports 0, and a supported one that happens
// to be off reports 2.
pub enum AnsiModeSetting
    // 0 — the terminal does not know this mode.
    AnsiModeUnknown
    // 1 — set.
    AnsiModeIsSet
    // 2 — reset.
    AnsiModeIsReset
    // 3 — permanently set; the terminal will not turn it off.
    AnsiModeAlwaysSet
    // 4 — permanently reset.
    AnsiModeAlwaysReset

// AnsiReply is a terminal's answer, read back into a value.
pub enum AnsiReply
    // CPR — `CSI <row> ; <col> R`, both one-based.
    AnsiCursorPositionReply(row: Int, col: Int)
    // DSR — `CSI 0 n`, the terminal saying it is there.
    AnsiDeviceOkReply
    // Primary DA — `CSI ? <class> ; <options> c`.  The options are
    // kept as a list because their meaning is per-class and a program
    // that cares is looking for one number in it.
    AnsiDeviceAttributesReply(class: Int, options: [Int])
    // Secondary DA — `CSI > <kind> ; <version> ; <patch> c`.
    AnsiSecondaryAttributesReply(kind: Int, version: Int, patch: Int)
    // `CSI 8 ; <rows> ; <cols> t`, the answer to the text-area query.
    AnsiTextAreaSizeReply(rows: Int, cols: Int)
    // DECRPM — `CSI ? <mode> ; <setting> $ y`.
    AnsiModeReply(mode: Int, setting: AnsiModeSetting)

// ── Reading one back ────────────────────────────────────────────────

// The five replies whose whole content fits in three parameters.
//
// `reply_of` and `reply_of_params` both come through here, so the
// parser path and the snapshot path cannot answer differently — which
// is the one bug a second copy of this table would eventually have.
// Primary DA is the exception and is handled by its callers, because
// its options are a LIST and building one is an allocation this
// function must not make on the dispatches that are not replies.
fn decode(marker: Int, count: Int, p0: Int, p1: Int, p2: Int, intermediate: Int,
          final_byte: Int) -> ?AnsiReply
    if final_byte == 0x52 and marker == vtparse.NO_PRIVATE_MARKER and count >= 2
        Some(AnsiCursorPositionReply(p0, p1))
    else if final_byte == 0x6E and marker == vtparse.NO_PRIVATE_MARKER and p0 == 0
        Some(AnsiDeviceOkReply)
    else if final_byte == 0x63 and marker == 0x3E
        Some(AnsiSecondaryAttributesReply(p0, p1, p2))
    else if final_byte == 0x74 and marker == vtparse.NO_PRIVATE_MARKER and count >= 3
        and p0 == 8
        Some(AnsiTextAreaSizeReply(p1, p2))
    else if final_byte == 0x79 and marker == 0x3F and intermediate == 0x24 and count >= 2
        Some(AnsiModeReply(p0, mode_setting(p1)))
    else
        None

// Whether a dispatch has primary DA's shape: `CSI ? <class> ; … c`.
fn is_primary_da(marker: Int, final_byte: Int) -> Bool
    final_byte == 0x63 and marker == 0x3F

// DECRPM's five answers.  Anything else is `AnsiModeUnknown`, which is
// also what 0 means, because a terminal reporting a number this
// revision does not define has not told us the mode is on.
fn mode_setting(n: Int) -> AnsiModeSetting
    if n == 1
        AnsiModeIsSet
    else if n == 2
        AnsiModeIsReset
    else if n == 3
        AnsiModeAlwaysSet
    else if n == 4
        AnsiModeAlwaysReset
    else
        AnsiModeUnknown

// The number DECRPM writes for a setting.
fn setting_number(s: AnsiModeSetting) -> Int
    match s
        AnsiModeUnknown     => 0
        AnsiModeIsSet       => 1
        AnsiModeIsReset     => 2
        AnsiModeAlwaysSet   => 3
        AnsiModeAlwaysReset => 4

// Primary DA's options: every parameter after the terminal class.
// An explicit loop rather than `list.map` over `list.range`: the range
// is refused at the `wasm` tier, and this package builds there.
fn options_of(p: vtparse.AnsiParser) -> [Int]
    var out: [Int] = []
    for i in 1..vtparse.param_count(p)
        let v = vtparse.param_at(p, i, 0)
        out = list.push(out, v)
    out

// The same, off a snapshot.
fn options_of_params(ps: vtparse.AnsiParams) -> [Int]
    var out: [Int] = []
    for i in 1..vtparse.params_count(ps)
        let v = vtparse.params_at(ps, i, 0)
        out = list.push(out, v)
    out

// Which of the six questions this is.
fn query_kind(q: AnsiQuery) -> Int
    match q
        AnsiCursorPositionQuery      => 0
        AnsiDeviceStatusQuery        => 1
        AnsiDeviceAttributesQuery    => 2
        AnsiSecondaryAttributesQuery => 3
        AnsiTextAreaSizeQuery        => 4
        AnsiModeQuery(_)             => 5

// The mode a DECRQM asked about, and -1 for a question that is not
// one.
fn query_mode(q: AnsiQuery) -> Int
    match q
        AnsiModeQuery(mode) => seqwrite.mode_number(mode)
        _                   => 0 - 1

// The mode a DECRPM answered about, and -1 for an answer that is not
// one.
fn reply_mode(r: AnsiReply) -> Int
    match r
        AnsiModeReply(n, _) => n
        _                   => 0 - 1

// Which of the six answers this is.
fn reply_kind(r: AnsiReply) -> Int
    match r
        AnsiCursorPositionReply(_, _)         => 0
        AnsiDeviceOkReply                     => 1
        AnsiDeviceAttributesReply(_, _)       => 2
        AnsiSecondaryAttributesReply(_, _, _) => 3
        AnsiTextAreaSizeReply(_, _)           => 4
        AnsiModeReply(_, _)                   => 5

// write_query appends the question to the caller's buffer.
//
// ```novo
// use vtquery
//
// fn main() [io]
//     let out = vtquery.write_query([], AnsiCursorPositionQuery)
//     // `out` now holds `CSI 6 n`.  Writing it is the caller's job,
//     // and so is deciding how long to wait for the answer.
//     println(str.from_int(list.len(out)))
// ```
pub fn write_query(out: [u8], q: AnsiQuery) -> [u8]
    match q
        AnsiCursorPositionQuery      => seqwrite.csi(out, 0, [6], [], 0x6E)
        AnsiDeviceStatusQuery        => seqwrite.csi(out, 0, [5], [], 0x6E)
        AnsiDeviceAttributesQuery    => seqwrite.csi(out, 0, [], [], 0x63)
        AnsiSecondaryAttributesQuery => seqwrite.csi(out, 0x3E, [], [], 0x63)
        AnsiTextAreaSizeQuery        => seqwrite.csi(out, 0, [18], [], 0x74)
        AnsiModeQuery(mode)          =>
            let marker = if seqwrite.mode_is_private(mode)
                0x3F
            else
                0
            seqwrite.csi(out, marker, [seqwrite.mode_number(mode)], [0x24], 0x70)

// reply_of reads a CSI dispatch back into a typed reply.
//
// `None` when the dispatch is not one of the six answers — which is
// most dispatches, because this function is meant to be called on
// every one and to say no cheaply.  The parser is passed rather than a
// snapshot so that a caller on the byte path pays nothing.
//
// ```novo
// use vtparse
// use vtquery
//
// fn main() [io]
//     var p = vtparse.parser_new()
//     for b in [0x1B, 0x5B, 0x31, 0x32, 0x3B, 0x34, 0x30, 0x52]
//         let step = vtparse.feed_byte(p, b)
//         p = step.parser
//         match step.action
//             AnsiCsiDispatch(f) =>
//                 match vtquery.reply_of(step.parser, f)
//                     Some(AnsiCursorPositionReply(row, col)) =>
//                         println(str.from_int(row))
//                         println(str.from_int(col))
//                     _ => println("not a reply")
//             _ => println("consumed")
// ```
pub fn reply_of(p: vtparse.AnsiParser, final_byte: Int) -> ?AnsiReply
    let marker = vtparse.private_marker_of(p)
    if is_primary_da(marker, final_byte)
        Some(AnsiDeviceAttributesReply(vtparse.param_at(p, 0, 0), options_of(p)))
    else
        decode(marker, vtparse.param_count(p), vtparse.param_at(p, 0, 0 - 1),
               vtparse.param_at(p, 1, 0 - 1), vtparse.param_at(p, 2, 0 - 1),
               vtparse.intermediate_at(p, 0), final_byte)

// reply_of_params is `reply_of` over a parameter snapshot, for a
// caller working from `feed`'s drained calls rather than from the
// parser.
pub fn reply_of_params(params: vtparse.AnsiParams, final_byte: Int) -> ?AnsiReply
    let marker = params.private_marker
    if is_primary_da(marker, final_byte)
        Some(AnsiDeviceAttributesReply(vtparse.params_at(params, 0, 0),
                                       options_of_params(params)))
    else
        let intermediate = if list.len(params.intermediates) == 0
            0
        else
            list.get(params.intermediates, 0)
        decode(marker, vtparse.params_count(params), vtparse.params_at(params, 0, 0 - 1),
               vtparse.params_at(params, 1, 0 - 1), vtparse.params_at(params, 2, 0 - 1),
               intermediate, final_byte)

// answers says whether a reply is an answer to a particular query.
//
// A program with more than one query in flight needs to match them up,
// and matching on the variant is not enough: two DECRQMs for different
// modes come back as two `AnsiModeReply`s that differ only in a field.
pub fn answers(q: AnsiQuery, r: AnsiReply) -> Bool
    // The shape has to agree, and so does the mode number — which is
    // -1 on both sides for the five questions that have only one
    // answer each, and the actual number for DECRQM, where two
    // queries in flight come back as two `AnsiModeReply`s that differ
    // in nothing else.
    query_kind(q) == reply_kind(r) and query_mode(q) == reply_mode(r)

// write_reply appends the answer a TERMINAL would send.
//
// The mirror of `write_query`, and it is here because the package is
// meant to be usable from both ends: a terminal emulator built on this
// parser has to answer the queries its child asks, and a test that
// feeds a program a synthetic terminal has to produce them.
pub fn write_reply(out: [u8], r: AnsiReply) -> [u8]
    match r
        AnsiCursorPositionReply(row, col)                  =>
            seqwrite.csi(out, 0, [row, col], [], 0x52)
        AnsiDeviceOkReply                                  => seqwrite.csi(out, 0, [0], [], 0x6E)
        AnsiDeviceAttributesReply(class, options)          =>
            seqwrite.csi(out, 0x3F, list.append([class], options), [], 0x63)
        AnsiSecondaryAttributesReply(kind, version, patch) =>
            seqwrite.csi(out, 0x3E, [kind, version, patch], [], 0x63)
        AnsiTextAreaSizeReply(rows, cols)                  =>
            seqwrite.csi(out, 0, [8, rows, cols], [], 0x74)
        AnsiModeReply(mode, setting)                       =>
            seqwrite.csi(out, 0x3F, [mode, setting_number(setting)], [0x24], 0x79)
