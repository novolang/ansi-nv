// seqwrite.nv — the other direction, where sequences are built into a
// buffer the caller owns.
//
// A library does not print, and a terminal library is where that rule
// is hardest to keep.  Every function here takes the byte buffer it
// should append to and returns it.  Nothing opens a file descriptor,
// nothing consults `isatty`, and nothing decides on the program's
// behalf that something should appear on a console.  That is why the
// package is `core`, and it is what lets the same calls build a screen
// update for a pty, a golden file for a test, a frame for a serial
// console, and a recording nobody will ever display.
//
// The buffer is the caller's.  `out` goes in and `out` comes back.  A
// caller batches a whole frame into one list and writes it once, which
// is a correctness property rather than an optimisation.  A screen
// update split across two writes is a screen update a reader can see
// tear.
//
// The parameters are one-based where the terminal is.  `cursor_to`
// takes row 1, column 1 for the top left, because that is what CUP
// means, and a library that subtracted one would be a library every
// caller adds one back for.  The grid types in tui-nv are zero-based,
// and the conversion happens at that boundary, once, where it is
// written down.

use vtparse
use sgr

// ── The bytes ───────────────────────────────────────────────────────
//
// Six private functions, and every public one in this module is a short
// spelling over them.  They append, and nothing here ever looks at what
// the caller already has in the buffer.

// One byte.
fn put(out: [u8], b: Int) -> [u8]
    list.push(out, b as u8)

// A number as its decimal digits.
//
// Not `str.from_int` and then its bytes, which allocates a string per
// parameter, and a frame of a few hundred cells is a few hundred
// parameters.  A value at or below zero is written `0`, which every one
// of these sequences reads as the default.  ECMA-48 § 5.4.2 gives an
// omitted or zero parameter the function's own default, so
// `cursor_up(out, 0)` moves one row rather than none.
fn put_int(out: [u8], n: Int) -> [u8]
    if n <= 0
        put(out, 0x30)
    else
        var digits: [Int] = []
        var v = n
        while v > 0
            digits = list.push(digits, 0x30 + v % 10)
            v = v / 10
        var o = out
        var k = list.len(digits) - 1
        while k >= 0
            o = put(o, list.get(digits, k))
            k = k - 1
        o

// `ESC [`.
fn csi_open(out: [u8]) -> [u8]
    put(put(out, 0x1B), 0x5B)

// `CSI <n> <final>`.
fn csi1(out: [u8], n: Int, final_byte: Int) -> [u8]
    put(put_int(csi_open(out), n), final_byte)

// `CSI <a> ; <b> <final>`.
fn csi2(out: [u8], a: Int, b: Int, final_byte: Int) -> [u8]
    put(put_int(put(put_int(csi_open(out), a), 0x3B), b), final_byte)

// The string terminator the caller chose.
fn string_end(out: [u8], t: AnsiStringEnd) -> [u8]
    match t
        AnsiEndWithBel => put(out, 0x07)
        AnsiEndWithSt  => put(put(out, 0x1B), 0x5C)

// A string's bytes, as the list the OSC writers take.
fn str_bytes(text: Str) -> [u8]
    put_text([], text)

// The number DECSCUSR writes for a shape.
fn shape_number(shape: AnsiCursorShape) -> Int
    match shape
        AnsiShapeDefault      => 0
        AnsiBlinkingBlock     => 1
        AnsiSteadyBlock       => 2
        AnsiBlinkingUnderline => 3
        AnsiSteadyUnderline   => 4
        AnsiBlinkingBar       => 5
        AnsiSteadyBar         => 6

// The number ED writes for an erase mode.
fn erase_number(mode: AnsiEraseMode) -> Int
    match mode
        AnsiEraseToEnd      => 0
        AnsiEraseToStart    => 1
        AnsiEraseAll        => 2
        AnsiEraseScrollback => 3

// ── Cursor ──────────────────────────────────────────────────────────

// cursor_to appends CUP, which puts the cursor at `row` and `col`.
// Both are one-based, and the top left is 1, 1.
pub fn cursor_to(out: [u8], row: Int, col: Int) -> [u8]
    csi2(out, row, col, 0x48)

// cursor_up appends CUU, which moves up `n` rows and stops at the top
// of the scroll region.
pub fn cursor_up(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x41)

// cursor_down appends CUD, which moves down `n` rows and stops at the
// bottom of the scroll region.
pub fn cursor_down(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x42)

// cursor_forward appends CUF, which moves right `n` columns.
pub fn cursor_forward(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x43)

// cursor_back appends CUB, which moves left `n` columns.
pub fn cursor_back(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x44)

// cursor_column appends CHA, which moves to column `col` and leaves
// the row alone.  The column is one-based.
pub fn cursor_column(out: [u8], col: Int) -> [u8]
    csi1(out, col, 0x47)

// cursor_row appends VPA, which moves to row `row` and leaves the
// column alone.  The row is one-based.
pub fn cursor_row(out: [u8], row: Int) -> [u8]
    csi1(out, row, 0x64)

// cursor_next_line appends CNL, which moves down `n` rows to column
// 1.
pub fn cursor_next_line(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x45)

// cursor_prev_line appends CPL, which moves up `n` rows to column 1.
pub fn cursor_prev_line(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x46)

// cursor_save appends DECSC (`ESC 7`), which saves the cursor position
// and the current attributes together.
//
// The attribute half is why this is not interchangeable with SCOSC
// (`CSI s`), and why a program that saves and restores around a status
// line does not have to re-emit its colours.
pub fn cursor_save(out: [u8]) -> [u8]
    put(put(out, 0x1B), 0x37)

// cursor_restore appends DECRC (`ESC 8`).
pub fn cursor_restore(out: [u8]) -> [u8]
    put(put(out, 0x1B), 0x38)

// AnsiCursorShape is what the cursor looks like.  It is DECSCUSR's six
// settings plus the terminal's own default.
pub enum AnsiCursorShape
    // `CSI 0 q`, whatever the user configured.
    AnsiShapeDefault
    AnsiBlinkingBlock
    AnsiSteadyBlock
    AnsiBlinkingUnderline
    AnsiSteadyUnderline
    AnsiBlinkingBar
    AnsiSteadyBar

// cursor_shape appends DECSCUSR.
pub fn cursor_shape(out: [u8], shape: AnsiCursorShape) -> [u8]
    put(put(put_int(csi_open(out), shape_number(shape)), 0x20), 0x71)

// ── Erasing and scrolling ───────────────────────────────────────────

// AnsiEraseMode is how much of a line or a display to erase.
pub enum AnsiEraseMode
    // From the cursor to the end, which is mode 0.
    AnsiEraseToEnd
    // From the start to the cursor, which is mode 1.
    AnsiEraseToStart
    // The whole line, or the whole display, which is mode 2.
    AnsiEraseAll
    // The scrollback, which is mode 3 and ED only.  It is xterm's
    // extension, and it is what a program that wants a clean screen
    // needs.  `AnsiEraseAll` leaves the scrollback in place, which is
    // what makes a `clear` that scrolls the old screen up out of
    // view.
    AnsiEraseScrollback

// erase_display appends ED.
pub fn erase_display(out: [u8], mode: AnsiEraseMode) -> [u8]
    csi1(out, erase_number(mode), 0x4A)

// erase_line appends EL.  `AnsiEraseScrollback` is not a line mode and
// is written as `AnsiEraseAll`.
pub fn erase_line(out: [u8], mode: AnsiEraseMode) -> [u8]
    let n = erase_number(mode)
    if n == 3
        csi1(out, 2, 0x4B)
    else
        csi1(out, n, 0x4B)

// erase_chars appends ECH, which blanks `n` cells from the cursor
// without moving anything.
pub fn erase_chars(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x58)

// scroll_region appends DECSTBM, which sets the scrolling region to
// rows `top`..`bottom`.  Both are one-based and inclusive.
//
// Setting the region also homes the cursor.  That is an effect of the
// sequence rather than of this function, and it is the one every caller
// forgets.
pub fn scroll_region(out: [u8], top: Int, bottom: Int) -> [u8]
    csi2(out, top, bottom, 0x72)

// scroll_region_reset appends DECSTBM with no parameters, so that the
// whole screen scrolls again.
pub fn scroll_region_reset(out: [u8]) -> [u8]
    put(csi_open(out), 0x72)

// scroll_up appends SU, which moves the region's content up `n`
// rows.
pub fn scroll_up(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x53)

// scroll_down appends SD, which moves the region's content down `n`
// rows.
pub fn scroll_down(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x54)

// insert_lines appends IL, which puts `n` blank lines at the cursor and
// pushes the rest of the region down.
pub fn insert_lines(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x4C)

// delete_lines appends DL, which removes `n` lines at the cursor and
// pulls the rest of the region up.
pub fn delete_lines(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x4D)

// insert_chars appends ICH, which puts `n` blank cells at the cursor
// and pushes the rest of the line right.
pub fn insert_chars(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x40)

// delete_chars appends DCH, which removes `n` cells at the cursor and
// pulls the rest of the line left.
pub fn delete_chars(out: [u8], n: Int) -> [u8]
    csi1(out, n, 0x50)

// ── Modes ───────────────────────────────────────────────────────────

// AnsiMode is a terminal setting that can be turned on and off.
//
// The named variants are the ones a program uses by name.  The two
// numeric ones are the escape hatch, because the DEC private space is
// open-ended and a library that knew only the modes it had heard of
// would be a library every caller writes raw bytes around.
pub enum AnsiMode
    // IRM, `CSI 4 h`, which inserts rather than replaces.  It is an
    // ANSI mode rather than a private one.
    AnsiInsertMode
    // DECAWM, `CSI ? 7 h`, which wraps at the right margin.
    AnsiAutoWrap
    // DECTCEM, `CSI ? 25 h`, which shows the cursor.
    AnsiCursorVisible
    // `CSI ? 1049 h`, the alternate screen.  It saves the cursor and
    // clears on the way in.  The two older spellings, 47 and 1047, do
    // not save the cursor, so a program that means full screen means
    // this one.
    AnsiAltScreen
    // `CSI ? 2004 h`, bracketed paste.  Pasted text arrives wrapped in
    // `CSI 200 ~` and `CSI 201 ~`, so an editor can tell a paste from
    // typing.
    AnsiBracketedPaste
    // `CSI ? 1000 h`, which reports button presses and releases.
    AnsiMouseClicks
    // `CSI ? 1002 h`, which reports the above plus motion while a
    // button is down.
    AnsiMouseDrag
    // `CSI ? 1003 h`, which reports the above plus motion with no
    // button down.
    AnsiMouseMotion
    // `CSI ? 1006 h`, which reports mouse positions in the SGR
    // encoding.  That encoding is the only one that works past column
    // 223.
    AnsiMouseSgr
    // `CSI ? 1004 h`, which reports focus in and out.
    AnsiFocusEvents
    // `CSI ? 2026 h`, synchronised output.  The terminal holds the
    // frame until the mode is reset, so a large update cannot tear.
    AnsiSyncOutput
    // Any other DEC private mode, by number.
    AnsiPrivateMode(number: Int)
    // Any other ANSI mode, by number.
    AnsiAnsiMode(number: Int)

// set_mode appends SM or DECSET for the mode.
pub fn set_mode(out: [u8], mode: AnsiMode) -> [u8]
    let marker = if mode_is_private(mode)
        0x3F
    else
        0
    csi(out, marker, [mode_number(mode)], [], 0x68)

// reset_mode appends RM or DECRST for the mode.
pub fn reset_mode(out: [u8], mode: AnsiMode) -> [u8]
    let marker = if mode_is_private(mode)
        0x3F
    else
        0
    csi(out, marker, [mode_number(mode)], [], 0x6C)

// mode_number is the number a mode goes on the wire as, and whether it
// is a private one.
pub fn mode_number(mode: AnsiMode) -> Int
    match mode
        AnsiInsertMode     => 4
        AnsiAutoWrap       => 7
        AnsiCursorVisible  => 25
        AnsiAltScreen      => 1049
        AnsiBracketedPaste => 2004
        AnsiMouseClicks    => 1000
        AnsiMouseDrag      => 1002
        AnsiMouseMotion    => 1003
        AnsiMouseSgr       => 1006
        AnsiFocusEvents    => 1004
        AnsiSyncOutput     => 2026
        AnsiPrivateMode(n) => n
        AnsiAnsiMode(n)    => n

// mode_is_private says whether a mode is written with the `?` marker.
pub fn mode_is_private(mode: AnsiMode) -> Bool
    match mode
        AnsiInsertMode  => false
        AnsiAnsiMode(_) => false
        _               => true

// ── Colour and attributes ───────────────────────────────────────────

// sgr appends `CSI <params> m` for a parameter list the caller already
// has, from `sgr.sgr_transition`, `sgr.sgr_full` or its own
// arithmetic.
pub fn sgr(out: [u8], params: [Int]) -> [u8]
    csi(out, 0, params, [], 0x6D)

// sgr_reset appends `CSI 0 m`.
pub fn sgr_reset(out: [u8]) -> [u8]
    csi1(out, 0, 0x6D)

// sgr_change appends the shortest `CSI m` that takes the terminal from
// `from` to `to`, and appends nothing at all when the two are equal.
//
// The function a renderer calls once per run of cells.  Appending
// nothing for an unchanged style is the behaviour that matters.  A
// screen update where most cells share a style is mostly this function
// answering its argument.
//
// ```novo
// use sgr
// use seqwrite
//
// fn main() [io]
//     let plain = sgr.attrs_default()
//     let out = seqwrite.sgr_change([], plain, plain)
//     println(str.from_int(list.len(out)))     // 0 — nothing changed
// ```
pub fn sgr_change(out: [u8], from: sgr.SgrAttrs, to: sgr.SgrAttrs) -> [u8]
    let params = sgr.sgr_transition_sub(from, to)
    if vtparse.params_count(params) == 0
        out
    else
        csi_params(out, params, 0x6D)

// ── Text ────────────────────────────────────────────────────────────

// put_codepoint appends one codepoint, UTF-8 encoded.
//
// The one function on the writing side that a caller cannot write
// itself in one line.  The four-branch encoding is where a hand-rolled
// terminal writer gets a wide character wrong.
pub fn put_codepoint(out: [u8], ch: Int) -> [u8]
    let c = if ch < 0 or ch > 0x10FFFF or ch >= 0xD800 and ch <= 0xDFFF
        0xFFFD
    else
        ch
    if c < 0x80
        put(out, c)
    else if c < 0x800
        put(put(out, 0xC0 + c / 64), 0x80 + c % 64)
    else if c < 0x10000
        put(put(put(out, 0xE0 + c / 4096), 0x80 + c / 64 % 64), 0x80 + c % 64)
    else
        put(put(put(put(out, 0xF0 + c / 262144), 0x80 + c / 4096 % 64),
                0x80 + c / 64 % 64),
                0x80 + c % 64)

// put_text appends a string's bytes unchanged.
//
// Unchanged means unchanged: no escaping, no wrapping, no width
// arithmetic.  A caller with text from somewhere it does not trust
// wants `put_text_safe`.
pub fn put_text(out: [u8], text: Str) -> [u8]
    var o = out
    for i in 0..str.len(text)
        o = put(o, str.byte_at_or(text, i, 0))
    o

// put_text_safe appends a string with every C0 control, every C1
// control and every ESC replaced by a printable stand-in.
//
// What a program renders a log line, a filename or a commit message
// with.  Text from outside the program can contain `ESC ] 52 ; c ;`,
// which is a clipboard write, and a renderer that passed it through has
// handed whoever wrote that text the user's clipboard.  There is no
// flag that turns the replacement off.  A caller that wants the
// sequences calls `put_text`, where the name says so.
pub fn put_text_safe(out: [u8], text: Str) -> [u8]
    var o = out
    let n = str.len(text)
    // True on the second byte of a C1 control, which the branch that
    // wrote its stand-in has already read.
    var consumed = false
    for i in 0..n
        let b = str.byte_at_or(text, i, 0)
        let next = str.byte_at_or(text, i + 1, 0)
        if consumed
            consumed = false
        else if b < 0x20
            // `^A` for 0x01, and `^[` for the ESC itself.
            o = put(put(o, 0x5E), 0x40 + b)
        else if b == 0x7F
            o = put(put(o, 0x5E), 0x3F)
        else if b == 0xC2 and i + 1 < n and next >= 0x80 and next <= 0x9F
            // A C1 control, which in UTF-8 is two bytes.  It uses `~`
            // rather than `^`, so that a reader can tell `ESC` from the
            // 8-bit CSI it stands in for.
            o = put(put(o, 0x7E), 0x40 + (next - 0x80))
            consumed = true
        else
            o = put(o, b)
    o

// ── Strings ─────────────────────────────────────────────────────────

// osc appends `OSC <code> ; <payload> <terminator>`.
//
// The payload is bytes rather than a string, because OSC 52's is base64
// and OSC 4's is a colour specification.  Neither is text this package
// should have an opinion about.
pub fn osc(out: [u8], code: Int, payload: [u8], terminator: AnsiStringEnd) -> [u8]
    var o = put(put(out, 0x1B), 0x5D)
    o = put_int(o, code)
    o = put(o, 0x3B)
    for b in payload
        o = put(o, b as Int)
    string_end(o, terminator)

// AnsiStringEnd is which terminator to write a string sequence with.
//
// It is a separate type from the parser's `AnsiTerminator` on purpose.
// That one reports what arrived and this one chooses what to send, and
// the two are not the same decision.  A program answering a query
// echoes the terminator it was asked with, and a program starting an
// exchange picks ST.
pub enum AnsiStringEnd
    AnsiEndWithBel
    AnsiEndWithSt

// set_title appends OSC 0, which sets the window title and the icon
// name together.  That is what every terminal does with OSC 0, 1 and
// 2.
pub fn set_title(out: [u8], title: Str) -> [u8]
    osc(out, 0, str_bytes(title), AnsiEndWithBel)

// clipboard_write appends OSC 52 with an already-base64 payload.
//
// The base64 is the caller's, because a `core` package that grew a
// base64 encoder for one sequence would carry it for every consumer
// that never writes a clipboard.  base64-nv is the package that
// encodes it.
pub fn clipboard_write(out: [u8], selection: Str, base64_payload: Str) -> [u8]
    osc(out, 52, str_bytes(selection + ";" + base64_payload), AnsiEndWithSt)

// ── Raw ─────────────────────────────────────────────────────────────

// csi appends `CSI <private> <params> <intermediates> <final>` for a
// sequence this module does not name.
//
// The escape hatch, and it is `pub` on purpose.  A package that made
// its callers choose between a function it provides and raw bytes they
// hope are right would get raw bytes.  `private` is 0 for none.
pub fn csi(out: [u8], private: Int, params: [Int], intermediates: [Int], final_byte: Int) -> [u8]
    var o = csi_open(out)
    if private != 0
        o = put(o, private)
    var first = true
    for v in params
        if first == false
            o = put(o, 0x3B)
        o = put_int(o, v)
        first = false
    for b in intermediates
        o = put(o, b)
    put(o, final_byte)

// csi_params appends a CSI built from a parameter snapshot, colon
// groups and all.
//
// It stands beside `csi`, which takes `params: [Int]`.  That is a list
// of semicolon-separated parameters and cannot express a colon group,
// so `CSI 4:3 m`, the curly underline, and `CSI 38:2::R:G:B m`, T.416's
// direct colour, have no spelling through it.  This takes the parser's
// own `AnsiParams`, whose flat values-and-groups pair carries them, so
// a sequence this package parsed can be written back out byte for
// byte.
//
// An empty slot, such as the middle one of `38:2::R:G:B`, is written as
// nothing between two colons, which is what it was.
//
// ```novo
// use vtparse
// use seqwrite
//
// fn main() [io]
//     var p = vtparse.parser_new()
//     for b in [0x1B, 0x5B, 0x34, 0x3A, 0x33, 0x6D]
//         let step = vtparse.feed_byte(p, b)
//         p = step.parser
//     // The same sequence again, out of what the parser kept.
//     let out = seqwrite.csi_params([], vtparse.params_of(p), 0x6D)
//     println("${list.len(out)}")
// ```
pub fn csi_params(out: [u8], params: vtparse.AnsiParams, final_byte: Int) -> [u8]
    var o = csi_open(out)
    if params.private_marker != vtparse.NO_PRIVATE_MARKER
        o = put(o, params.private_marker)
    for i in 0..vtparse.params_count(params)
        if i > 0
            o = put(o, 0x3B)
        for j in 0..vtparse.params_sub_count(params, i)
            if j > 0
                o = put(o, 0x3A)
            let v = vtparse.params_sub_at(params, i, j, vtparse.PARAM_EMPTY)
            if v != vtparse.PARAM_EMPTY
                o = put_int(o, v)
    for b in params.intermediates
        o = put(o, b)
    put(o, final_byte)

// esc appends `ESC <intermediates> <final>`.
pub fn esc(out: [u8], intermediates: [Int], final_byte: Int) -> [u8]
    var o = put(out, 0x1B)
    for b in intermediates
        o = put(o, b)
    put(o, final_byte)
