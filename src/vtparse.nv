// vtparse.nv — the VT/xterm state machine, as a value that takes one
// byte and hands back one action.
//
// Every body here is a `todo()`; the signatures are the design.
//
// The machine is Paul Williams' DEC parser ("A parser for DEC's
// ANSI-compatible video terminals") with the four additions every
// modern terminal needs: UTF-8 decoding in the ground state, colon
// sub-parameters inside a CSI (ITU-T T.416, which is how a curly
// underline and its colour arrive), OSC strings terminated by either
// BEL or ST, and a private marker kept separate from the intermediates
// so that `CSI ? 1049 h` and `CSI 1049 h` cannot be confused.
//
// THE PARSER IS A VALUE, AND THAT IS THE LOAD-BEARING DECISION.  A
// dispatch action names its final byte and nothing else; the numbers
// that came with it stay on the parser, read back through `param_at`
// and its neighbours.  Because `feed_byte` returns the parser rather
// than mutating one, the value it returns still HOLDS those numbers —
// so a caller may keep it, dispatch on the action, and read the
// parameters at leisure, which a mutable parser cannot promise.  It is
// also why nothing on the hot path allocates: `AnsiAction` carries at
// most two integers.
//
// A CHUNK MAY SPLIT ANYWHERE.  There is no "give me a whole sequence"
// entry point, because a read from a pty ends where the kernel says it
// ends — in the middle of a parameter list, between the two bytes of a
// UTF-8 codepoint, halfway through an OSC payload.  Every one of those
// is an ordinary rest position for this machine.
//
// WHAT IS NOT HERE.  A grid, a cursor, a scrollback, and any notion of
// what a sequence MEANS.  `CSI 2 J` arrives as
// `AnsiCsiDispatch(final_byte: 0x4A)` with parameter 0 equal to 2, and
// what to erase is the caller's model to change.  That separation is
// the reason this package can be the parser for a terminal emulator, a
// multiplexer, a log scrubber and a device driving a serial console
// without any of them inheriting the others' idea of a screen.
//
// ```novo
// use std.str
// use vtparse
//
// fn main() [io]
//     var p = vtparse.parser_new()
//     for b in [0x1B, 0x5B, 0x32, 0x3B, 0x31, 0x48]
//         let step = vtparse.feed_byte(p, b)
//         p = step.parser
//         match step.action
//             AnsiCsiDispatch(_) =>
//                 // CUP: row 2, column 1, and the parameters are still
//                 // readable off the parser the dispatch came with.
//                 println(str.from_int(vtparse.param_at(step.parser, 0, 1)))
//                 println(str.from_int(vtparse.param_at(step.parser, 1, 1)))
//             _ => println("consumed")
// ```

// AnsiState is where the machine is resting between bytes.
//
// It is `pub` because a caller that has to reason about a partial read
// — a proxy deciding whether it is safe to inject a sequence, a test
// asserting that a chunk boundary left nothing behind — needs to ask,
// and because `AnsiGround` is the only state in which injecting bytes
// into the stream is safe.
pub enum AnsiState
    // Between sequences: the next byte is text, a C0 control, or the
    // ESC that starts one.
    AnsiGround
    // ESC has arrived and the next byte decides what kind of sequence
    // this is.
    AnsiEscape
    // ESC with intermediates collected, waiting for the final byte.
    AnsiEscapeIntermediate
    // CSI has arrived; no parameter byte has been seen yet, so the
    // next byte may still be the private marker.
    AnsiCsiEntry
    // Inside a CSI's parameter list, collecting digits, semicolons and
    // colons.
    AnsiCsiParam
    // Inside a CSI, past the parameters, collecting intermediates.
    AnsiCsiIntermediate
    // Inside a CSI that has already broken a rule — too many
    // parameters, a parameter too large, an intermediate before the
    // private marker.  The bytes are consumed to the final byte and
    // the sequence is dropped rather than half-applied.
    AnsiCsiIgnore
    // Inside an OSC string, and every payload byte is coming out as
    // `AnsiOscPut`.
    AnsiOscString
    // Inside a DCS's parameter list.
    AnsiDcsParam
    // Inside a DCS's payload, and every byte is coming out as
    // `AnsiDcsPut`.
    AnsiDcsPassthrough
    // Inside SOS, PM or APC — a string this package consumes and does
    // not report, so that its payload cannot leak back into the ground
    // state and be re-parsed as text.
    AnsiIgnoredString
    // Part-way through a multi-byte UTF-8 codepoint, waiting for
    // continuation bytes.
    AnsiUtf8Continuation

// AnsiTerminator is which of the two endings an OSC or DCS string
// actually used.
//
// It is reported rather than normalised because the answer decides what
// a program echoes back: a terminal that was asked with BEL is answered
// with BEL, and xterm's own OSC 52 handling is the case that made this
// worth a variant instead of a `Bool`.
pub enum AnsiTerminator
    // BEL, 0x07 — xterm's original, still what most programs send.
    AnsiBelTerminated
    // ST, ESC backslash — the form ECMA-48 defines.
    AnsiStTerminated

// AnsiFault is a rule the incoming bytes broke.
//
// A fault is reported and the sequence is dropped; the machine never
// stops, because a terminal that stopped parsing on a malformed
// sequence would be a terminal one bad byte could wedge.  Every fault
// names a LIMIT rather than a syntax error, because the syntax has no
// errors — an unrecognised final byte is a sequence for a feature this
// package does not implement, not a mistake.
pub enum AnsiFault
    // More parameters than `AnsiLimits.params_max`.
    AnsiTooManyParams
    // More sub-parameters in one group than `AnsiLimits.subs_max`.
    AnsiTooManySubParams
    // A parameter's digits ran past `AnsiLimits.param_max`.
    AnsiParamTooLarge
    // More intermediate bytes than `AnsiLimits.intermediates_max`.
    AnsiTooManyIntermediates
    // An OSC payload ran past `AnsiLimits.osc_bytes_max`.  The bytes
    // already reported stand; the rest of the string is consumed and
    // dropped.
    AnsiOscTooLong
    // A DCS payload ran past `AnsiLimits.dcs_bytes_max`.
    AnsiDcsTooLong
    // A UTF-8 sequence that is not one: a continuation byte in the
    // ground state, a lead byte that promises more bytes than arrived,
    // an overlong form, or a surrogate.  `REPLACEMENT_CHAR` is
    // reported as an `AnsiPrint` immediately after.
    AnsiBadUtf8

// AnsiAction is one thing the caller has to do about one byte.
//
// It is deliberately small: at most one integer, no lists, nothing
// borrowed from the parser.  Everything a dispatch needs beyond its
// final byte — the parameters, their sub-parameters, the intermediates,
// the private marker — is read off the parser the step returned.
pub enum AnsiAction
    // The byte was consumed and there is nothing to do: a digit inside
    // a parameter list, a continuation byte part-way through a
    // codepoint, the `[` after an ESC.
    AnsiNothing
    // A whole codepoint to put on the screen.  Combining marks and
    // wide characters arrive as themselves; how many cells one takes
    // is the caller's question, and textwrap-nv is where the answer
    // lives.
    AnsiPrint(ch: Int)
    // A C0 or C1 control that acts on its own: BS, HT, LF, VT, FF, CR,
    // BEL, and the 8-bit forms.
    AnsiExecute(control: Int)
    // ESC <intermediates> <final> — DECSC (`ESC 7`), DECRC (`ESC 8`),
    // IND, NEL, RI, RIS, and the charset designators.
    AnsiEscDispatch(final_byte: Int)
    // CSI <private> <params> <intermediates> <final> — the whole of
    // cursor movement, erasing, scrolling, SGR, the mode sets, and the
    // queries.
    AnsiCsiDispatch(final_byte: Int)
    // An OSC string is starting.  Its numeric code is not known yet:
    // it arrives as the payload bytes before the first semicolon, so a
    // caller accumulates the payload and reads it with `osc_code` once
    // `AnsiOscEnd` has fired.
    AnsiOscStart
    // One byte of an OSC payload.  Reported a byte at a time so that
    // an OSC 52 clipboard payload of any length costs the parser
    // nothing to carry.
    AnsiOscPut(byte: Int)
    // The OSC string ended, and how.
    AnsiOscEnd(terminator: AnsiTerminator)
    // A DCS string is starting; its parameters and final byte are on
    // the parser, exactly as a CSI's are.
    AnsiDcsStart(final_byte: Int)
    // One byte of a DCS payload.
    AnsiDcsPut(byte: Int)
    // The DCS string ended, and how.
    AnsiDcsEnd(terminator: AnsiTerminator)
    // The incoming bytes broke a limit.  The sequence is dropped; the
    // machine carries on.
    AnsiRefused(why: AnsiFault)

// AnsiLimits is the ceiling on everything the parser has to remember.
//
// A parser with no ceiling is a parser a hostile stream can grow
// without bound, and a `core` package cannot decide for its caller how
// much memory that caller has.  So every bound is a number the caller
// sets, `default_limits` is what a terminal emulator wants, and
// `strict_limits` is what a device with kilobytes wants.
pub struct AnsiLimits
    // Parameters in one CSI or DCS.  xterm keeps 30; ECMA-48 sets no
    // limit.
    params_max: Int
    // Sub-parameters in one colon-separated group.  Six covers `4:3`
    // and `38:2::R:G:B`, which is every form in use.
    subs_max: Int
    // The largest value one parameter may hold.  A larger one is a
    // fault rather than a wrap, because a wrapped 65536 is a cursor
    // move to somewhere nobody asked for.
    param_max: Int
    // Intermediate bytes kept per sequence.  Two is every sequence
    // ECMA-48 defines.
    intermediates_max: Int
    // Bytes of OSC payload reported before `AnsiOscTooLong`.
    osc_bytes_max: Int
    // Bytes of DCS payload reported before `AnsiDcsTooLong`.
    dcs_bytes_max: Int

// AnsiParser is the machine: a state, the numbers collected so far,
// and the counters that enforce the limits.
//
// It is a value.  `feed_byte` takes one and returns one, so a caller
// may hold the parser a dispatch fired with, read its parameters, and
// keep feeding a different copy — which is what makes the "read the
// parameters afterwards" promise real rather than a convention.
pub struct AnsiParser
    state: AnsiState
    limits: AnsiLimits
    // One entry per parameter, in the order they arrived.  A parameter
    // the sequence left empty — the two in `CSI ; ; H` — is
    // `PARAM_EMPTY`, so that "absent" and "zero" stay different
    // answers and `param_at`'s fallback can do its job.
    values: [Int]
    // The group each entry of `values` belongs to.  Colon-separated
    // sub-parameters share a group, semicolon-separated ones do not,
    // so `38:2::1:2:3;4` is groups `0 0 0 0 0 0` then `1`.  A flat pair
    // of lists rather than a list of lists, because the sub-parameter
    // is a rarity and a nested allocation per CSI is not.
    groups: [Int]
    // The intermediate bytes, 0x20..0x2F, in order.
    intermediates: [Int]
    // The private marker, 0x3C..0x3F — `<`, `=`, `>` or `?` — or
    // `NO_PRIVATE_MARKER` when the sequence had none.
    private_marker: Int
    // Bytes of the current string payload already reported, against
    // the OSC and DCS ceilings.
    string_bytes: Int
    // The partly-assembled codepoint and how many continuation bytes
    // it still owes.
    utf8_value: Int
    utf8_owed: Int

// AnsiStep is one byte's worth of progress: the parser afterwards, and
// what the caller has to do about it.
pub struct AnsiStep
    parser: AnsiParser
    action: AnsiAction

// AnsiParams is a snapshot of everything a dispatch came with, as one
// value.
//
// The byte-at-a-time path does not need it — `param_at` reads the
// parser directly and allocates nothing.  It exists for `feed`, which
// hands back a list of actions the caller will look at after the
// parser has moved on, and for `sgr.apply_sgr`, which wants the whole
// parameter list as one argument.
pub struct AnsiParams
    values: [Int]
    groups: [Int]
    intermediates: [Int]
    private_marker: Int

// AnsiCall is one action and the parameters it fired with.
//
// This is the pairing `feed` exists to make: an action alone is not
// enough once the parser has moved past it, so the chunk path copies
// the numbers out at the moment of the dispatch.  That copy is the
// difference in cost between the two entry points, and it is why the
// byte path is the one a device uses.
pub struct AnsiCall
    action: AnsiAction
    params: AnsiParams

// AnsiDrained is a whole chunk's worth of calls, and the parser left
// over.
pub struct AnsiDrained
    parser: AnsiParser
    calls: [AnsiCall]

// The value `param_at` sees for a parameter the sequence left empty,
// as in the two empty slots of `CSI ; ; H`.
pub const PARAM_EMPTY = 0 - 1

// The value `private_marker_of` returns for a sequence that had none.
pub const NO_PRIVATE_MARKER = 0

// The codepoint reported after `AnsiBadUtf8` — U+FFFD, the replacement
// character.
pub const REPLACEMENT_CHAR = 0xFFFD

// ── The machinery behind the surface ────────────────────────────────
//
// Nothing below this line is `pub`.  It is the state machine itself —
// Williams' transition table with the four additions named at the top
// of this file — plus the four small constructors that every arm of it
// returns through.
//
// EVERY ONE OF THOSE CONSTRUCTORS BUILDS A FRESH STRUCT LITERAL rather
// than assigning a field of a copy.  That is not a style preference on
// this toolchain: `var q = p` followed by `q.field = v` writes through
// to the caller's struct (novo bug lang/struct-field-assignment-aliases-
// the-caller, filed 2026-09-18 from this package), which would silently
// break the promise that the parser a dispatch fired with still holds
// the parameters it fired with.  A literal is correct today and stays
// correct when that defect is fixed.

// The parser in `s`, carrying everything else unchanged.
fn at(p: AnsiParser, s: AnsiState) -> AnsiStep
    AnsiStep { parser: AnsiParser { state: s, limits: p.limits, values: p.values,
                                    groups: p.groups, intermediates: p.intermediates,
                                    private_marker: p.private_marker,
                                    string_bytes: p.string_bytes,
                                    utf8_value: p.utf8_value, utf8_owed: p.utf8_owed },
               action: AnsiNothing }

// The parser in `s` with one action to report, and nothing else moved.
fn act(p: AnsiParser, s: AnsiState, a: AnsiAction) -> AnsiStep
    AnsiStep { parser: AnsiParser { state: s, limits: p.limits, values: p.values,
                                    groups: p.groups, intermediates: p.intermediates,
                                    private_marker: p.private_marker,
                                    string_bytes: p.string_bytes,
                                    utf8_value: p.utf8_value, utf8_owed: p.utf8_owed },
               action: a }

// The parser in `s` with every buffer emptied — what `ESC`, `ESC [`,
// `ESC P` and `reset` all need, and what makes a sequence's numbers
// belong to that sequence alone.
fn cleared(p: AnsiParser, s: AnsiState, a: AnsiAction) -> AnsiStep
    AnsiStep { parser: AnsiParser { state: s, limits: p.limits, values: [], groups: [],
                                    intermediates: [], private_marker: NO_PRIVATE_MARKER,
                                    string_bytes: 0, utf8_value: 0, utf8_owed: 0 },
               action: a }

// The parser in `s` with new parameter lists.
fn with_params(p: AnsiParser, s: AnsiState, values: [Int], groups: [Int], a: AnsiAction) -> AnsiStep
    AnsiStep { parser: AnsiParser { state: s, limits: p.limits, values: values,
                                    groups: groups, intermediates: p.intermediates,
                                    private_marker: p.private_marker,
                                    string_bytes: p.string_bytes,
                                    utf8_value: p.utf8_value, utf8_owed: p.utf8_owed },
               action: a }

// The parser in `s` with one more intermediate byte.
fn with_intermediates(p: AnsiParser, s: AnsiState, inter: [Int]) -> AnsiStep
    AnsiStep { parser: AnsiParser { state: s, limits: p.limits, values: p.values,
                                    groups: p.groups, intermediates: inter,
                                    private_marker: p.private_marker,
                                    string_bytes: p.string_bytes,
                                    utf8_value: p.utf8_value, utf8_owed: p.utf8_owed },
               action: AnsiNothing }

// The parser with its private marker recorded.
fn with_marker(p: AnsiParser, marker: Int) -> AnsiStep
    AnsiStep { parser: AnsiParser { state: p.state, limits: p.limits, values: p.values,
                                    groups: p.groups, intermediates: p.intermediates,
                                    private_marker: marker,
                                    string_bytes: p.string_bytes,
                                    utf8_value: p.utf8_value, utf8_owed: p.utf8_owed },
               action: AnsiNothing }

// The parser in `s` part-way through a string sequence.
//
// `utf8_owed` CARRIES THE STRING'S PENDING ESC while the machine is in
// one of the three string states: 1 after an ESC that may yet be the
// first byte of ST, 0 otherwise.  The field is free there — no UTF-8
// codepoint is in flight inside an OSC or a DCS payload — and the
// published `AnsiParser` has no field of its own for it.  Naming the
// reuse here is cheaper than a breaking change to a struct seven
// packages already depend on.
fn with_string(p: AnsiParser, s: AnsiState, seen: Int, esc_pending: Int, a: AnsiAction) -> AnsiStep
    AnsiStep { parser: AnsiParser { state: s, limits: p.limits, values: p.values,
                                    groups: p.groups, intermediates: p.intermediates,
                                    private_marker: p.private_marker,
                                    string_bytes: seen, utf8_value: 0,
                                    utf8_owed: esc_pending },
               action: a }

// The parser in `s` part-way through a codepoint.
fn with_utf8(p: AnsiParser, s: AnsiState, value: Int, owed: Int, a: AnsiAction) -> AnsiStep
    AnsiStep { parser: AnsiParser { state: s, limits: p.limits, values: p.values,
                                    groups: p.groups, intermediates: p.intermediates,
                                    private_marker: p.private_marker,
                                    string_bytes: p.string_bytes,
                                    utf8_value: value, utf8_owed: owed },
               action: a }

// ── Reading a parameter list ────────────────────────────────────────
//
// The four readers below are the whole of what `param_at` and its
// neighbours are, and the snapshot accessors call the same four — so
// `params_at(params_of(p), i, d)` and `param_at(p, i, d)` cannot come
// to different answers, which is the one bug a second copy would have.

// How many parameters a group list describes: a group number is
// assigned in order from 0, so the last one plus one is the count.
fn count_of(groups: [Int]) -> Int
    let n = list.len(groups)
    if n == 0
        0
    else
        list.get(groups, n - 1) + 1

// Where group `g` starts in the flat list, or -1 when there is no
// such group.
fn group_start(groups: [Int], g: Int) -> Int
    for k in 0..list.len(groups)
        if list.get(groups, k) == g
            return k
    0 - 1

// Parameter `i`, with `fallback` for absent and for empty alike.
fn at_of(values: [Int], groups: [Int], i: Int, fallback: Int) -> Int
    let k = group_start(groups, i)
    if k < 0
        fallback
    else
        let v = list.get(values, k)
        if v == PARAM_EMPTY
            fallback
        else
            v

// How many entries group `i` holds, counting the parameter itself.
fn sub_count_of(groups: [Int], i: Int) -> Int
    var n = 0
    for k in 0..list.len(groups)
        if list.get(groups, k) == i
            n = n + 1
    n

// Sub-parameter `j` of parameter `i`.
fn sub_at_of(values: [Int], groups: [Int], i: Int, j: Int, fallback: Int) -> Int
    let k = group_start(groups, i)
    if k < 0 or j < 0 or k + j >= list.len(groups)
        fallback
    else if list.get(groups, k + j) != i
        fallback
    else
        let v = list.get(values, k + j)
        if v == PARAM_EMPTY
            fallback
        else
            v

// The list with its last entry replaced.  A copy rather than an index
// assignment, because `xs[i] = v` writes into the buffer a parser the
// caller may still be holding shares with this one.
fn replaced_last(xs: [Int], v: Int) -> [Int]
    list.push(list.slice(xs, 0, list.len(xs) - 1), v)

// ── Collecting a parameter list ─────────────────────────────────────

// One digit of the parameter currently open, or the first digit of a
// parameter this digit opens.
fn param_digit(p: AnsiParser, s: AnsiState, d: Int) -> AnsiStep
    let n = list.len(p.values)
    if n == 0
        if p.limits.params_max < 1
            act(p, AnsiCsiIgnore, AnsiRefused(AnsiTooManyParams))
        else
            with_params(p, s, list.push(p.values, d), list.push(p.groups, 0), AnsiNothing)
    else
        let last = list.get(p.values, n - 1)
        let v = if last == PARAM_EMPTY
            d
        else
            last * 10 + d
        if v > p.limits.param_max
            act(p, AnsiCsiIgnore, AnsiRefused(AnsiParamTooLarge))
        else
            with_params(p, s, replaced_last(p.values, v), p.groups, AnsiNothing)

// A semicolon: close the group that was open and open the next one.
//
// A semicolon with nothing before it opens TWO slots — the empty
// parameter it terminated and the one it begins — which is what keeps
// `CSI ; 5 H`'s first parameter a distinguishable absence rather than
// a zero.
fn param_next_group(p: AnsiParser, s: AnsiState) -> AnsiStep
    var values = p.values
    var groups = p.groups
    if list.len(values) == 0
        values = list.push(values, PARAM_EMPTY)
        groups = list.push(groups, 0)
    let g = list.get(groups, list.len(groups) - 1) + 1
    if g >= p.limits.params_max
        act(p, AnsiCsiIgnore, AnsiRefused(AnsiTooManyParams))
    else
        with_params(p, s, list.push(values, PARAM_EMPTY), list.push(groups, g), AnsiNothing)

// A colon: open another slot inside the group that is already open.
fn param_next_sub(p: AnsiParser, s: AnsiState) -> AnsiStep
    var values = p.values
    var groups = p.groups
    if list.len(values) == 0
        values = list.push(values, PARAM_EMPTY)
        groups = list.push(groups, 0)
    let g = list.get(groups, list.len(groups) - 1)
    if sub_count_of(groups, g) >= p.limits.subs_max
        act(p, AnsiCsiIgnore, AnsiRefused(AnsiTooManySubParams))
    else
        with_params(p, s, list.push(values, PARAM_EMPTY), list.push(groups, g), AnsiNothing)

// One intermediate byte, 0x20..0x2F.
fn collect_intermediate(p: AnsiParser, s: AnsiState, b: Int) -> AnsiStep
    if list.len(p.intermediates) >= p.limits.intermediates_max
        act(p, AnsiCsiIgnore, AnsiRefused(AnsiTooManyIntermediates))
    else
        with_intermediates(p, s, list.push(p.intermediates, b))

// ── The states ──────────────────────────────────────────────────────

// Ground: text, a C0 control, or the ESC that starts a sequence.
//
// A byte at 0x80 or above is the lead of a UTF-8 codepoint rather than
// a C1 control.  Every stream this package is pointed at is UTF-8, and
// a terminal that read 0xC3 as a C1 would print two replacement
// characters for every accented letter.
fn ground(p: AnsiParser, b: Int) -> AnsiStep
    if b == 0x1B
        cleared(p, AnsiEscape, AnsiNothing)
    else if b < 0x20
        act(p, AnsiGround, AnsiExecute(b))
    else if b < 0x7F
        act(p, AnsiGround, AnsiPrint(b))
    else if b == 0x7F
        act(p, AnsiGround, AnsiNothing)
    else
        utf8_lead(p, b)

// A UTF-8 lead byte.  0xC0 and 0xC1 would only ever begin an overlong
// two-byte form, and 0xF5..0xFF a codepoint past U+10FFFF, so both are
// refused where they arrive rather than at the end of the sequence.
fn utf8_lead(p: AnsiParser, b: Int) -> AnsiStep
    if b >= 0xC2 and b <= 0xDF
        with_utf8(p, AnsiUtf8Continuation, b - 0xC0, 1, AnsiNothing)
    else if b >= 0xE0 and b <= 0xEF
        with_utf8(p, AnsiUtf8Continuation, b - 0xE0, 2, AnsiNothing)
    else if b >= 0xF0 and b <= 0xF4
        with_utf8(p, AnsiUtf8Continuation, b - 0xF0, 3, AnsiNothing)
    else
        act(p, AnsiGround, AnsiRefused(AnsiBadUtf8))

// Whether the FIRST continuation byte is one this lead may take.
//
// Four leads have a narrower second byte than 0x80..0xBF, and checking
// them here is what makes an overlong form and a surrogate impossible
// rather than caught afterwards: 0xE0 may not be followed by 0x80..0x9F
// (overlong), 0xED may not be followed by 0xA0..0xBF (a surrogate),
// 0xF0 may not be followed by 0x80..0x8F (overlong), and 0xF4 may not
// be followed by 0x90..0xBF (past U+10FFFF).  Unicode 15 § 3.9,
// table 3-7.
fn utf8_first_ok(value: Int, owed: Int, b: Int) -> Bool
    if owed == 2 and value == 0x00 and b < 0xA0
        false
    else if owed == 2 and value == 0x0D and b > 0x9F
        false
    else if owed == 3 and value == 0x00 and b < 0x90
        false
    else if owed == 3 and value == 0x04 and b > 0x8F
        false
    else
        true

// Part-way through a codepoint.
//
// A byte that is not a continuation aborts the partial codepoint and is
// READ AGAIN from the ground state, which is what novo-vte's parser did
// and what xterm does: the alternative loses an ESC that arrived one
// byte after a truncated sequence, and losing an ESC is how a terminal
// prints a control sequence as text.
fn utf8_continuation(p: AnsiParser, b: Int) -> AnsiStep
    if b < 0x80 or b > 0xBF
        ground(AnsiParser { state: AnsiGround, limits: p.limits, values: p.values,
                            groups: p.groups, intermediates: p.intermediates,
                            private_marker: p.private_marker,
                            string_bytes: p.string_bytes, utf8_value: 0,
                            utf8_owed: 0 },
                            b)
    else if p.utf8_owed > 1 and utf8_first_ok(p.utf8_value, p.utf8_owed, b) == false
        with_utf8(p, AnsiGround, 0, 0, AnsiRefused(AnsiBadUtf8))
    else
        let v = p.utf8_value * 64 + (b - 0x80)
        if p.utf8_owed > 1
            with_utf8(p, AnsiUtf8Continuation, v, p.utf8_owed - 1, AnsiNothing)
        else
            with_utf8(p, AnsiGround, 0, 0, AnsiPrint(v))

// ESC has arrived and this byte says what kind of sequence it is.
fn escape(p: AnsiParser, b: Int) -> AnsiStep
    if b == 0x5B
        cleared(p, AnsiCsiEntry, AnsiNothing)
    else if b == 0x5D
        cleared(p, AnsiOscString, AnsiOscStart)
    else if b == 0x50
        cleared(p, AnsiDcsParam, AnsiNothing)
    else if b == 0x58 or b == 0x5E or b == 0x5F
        cleared(p, AnsiIgnoredString, AnsiNothing)
    else if b >= 0x20 and b <= 0x2F
        collect_intermediate(p, AnsiEscapeIntermediate, b)
    else if b >= 0x30 and b <= 0x7E
        act(p, AnsiGround, AnsiEscDispatch(b))
    else if b == 0x1B
        cleared(p, AnsiEscape, AnsiNothing)
    else if b < 0x20
        act(p, AnsiEscape, AnsiExecute(b))
    else if b == 0x7F
        act(p, AnsiEscape, AnsiNothing)
    else
        act(p, AnsiGround, AnsiNothing)

// ESC with intermediates collected — `ESC ( B` and its neighbours.
fn escape_intermediate(p: AnsiParser, b: Int) -> AnsiStep
    if b >= 0x20 and b <= 0x2F
        collect_intermediate(p, AnsiEscapeIntermediate, b)
    else if b >= 0x30 and b <= 0x7E
        act(p, AnsiGround, AnsiEscDispatch(b))
    else if b == 0x1B
        cleared(p, AnsiEscape, AnsiNothing)
    else if b < 0x20
        act(p, AnsiEscapeIntermediate, AnsiExecute(b))
    else
        act(p, AnsiGround, AnsiNothing)

// CSI, before any parameter byte — the one place the private marker
// may still arrive.
fn csi_entry(p: AnsiParser, b: Int) -> AnsiStep
    if b >= 0x30 and b <= 0x39
        param_digit(p, AnsiCsiParam, b - 0x30)
    else if b == 0x3B
        param_next_group(p, AnsiCsiParam)
    else if b == 0x3A
        param_next_sub(p, AnsiCsiParam)
    else if b >= 0x3C and b <= 0x3F
        with_marker(p, b)
    else if b >= 0x20 and b <= 0x2F
        collect_intermediate(p, AnsiCsiIntermediate, b)
    else if b >= 0x40 and b <= 0x7E
        act(p, AnsiGround, AnsiCsiDispatch(b))
    else if b == 0x1B
        cleared(p, AnsiEscape, AnsiNothing)
    else if b < 0x20
        act(p, AnsiCsiEntry, AnsiExecute(b))
    else
        act(p, AnsiCsiEntry, AnsiNothing)

// Inside the parameter list.  A private marker here is out of order —
// `CSI 1 ? h` is not a sequence — so the rest is consumed and dropped
// rather than half-applied.
fn csi_param(p: AnsiParser, b: Int) -> AnsiStep
    if b >= 0x30 and b <= 0x39
        param_digit(p, AnsiCsiParam, b - 0x30)
    else if b == 0x3B
        param_next_group(p, AnsiCsiParam)
    else if b == 0x3A
        param_next_sub(p, AnsiCsiParam)
    else if b >= 0x3C and b <= 0x3F
        at(p, AnsiCsiIgnore)
    else if b >= 0x20 and b <= 0x2F
        collect_intermediate(p, AnsiCsiIntermediate, b)
    else if b >= 0x40 and b <= 0x7E
        act(p, AnsiGround, AnsiCsiDispatch(b))
    else if b == 0x1B
        cleared(p, AnsiEscape, AnsiNothing)
    else if b < 0x20
        act(p, AnsiCsiParam, AnsiExecute(b))
    else
        act(p, AnsiCsiParam, AnsiNothing)

// Past the parameters, collecting intermediates — `CSI 2 SP q`.
fn csi_intermediate(p: AnsiParser, b: Int) -> AnsiStep
    if b >= 0x20 and b <= 0x2F
        collect_intermediate(p, AnsiCsiIntermediate, b)
    else if b >= 0x30 and b <= 0x3F
        at(p, AnsiCsiIgnore)
    else if b >= 0x40 and b <= 0x7E
        act(p, AnsiGround, AnsiCsiDispatch(b))
    else if b == 0x1B
        cleared(p, AnsiEscape, AnsiNothing)
    else if b < 0x20
        act(p, AnsiCsiIntermediate, AnsiExecute(b))
    else
        act(p, AnsiCsiIntermediate, AnsiNothing)

// A sequence that has already broken a rule: consume to the final byte
// and drop it.
fn csi_ignore(p: AnsiParser, b: Int) -> AnsiStep
    if b >= 0x40 and b <= 0x7E
        act(p, AnsiGround, AnsiNothing)
    else if b == 0x1B
        cleared(p, AnsiEscape, AnsiNothing)
    else
        act(p, AnsiCsiIgnore, AnsiNothing)

// One byte of an OSC payload, against the ceiling.
fn osc_payload(p: AnsiParser, b: Int) -> AnsiStep
    if p.string_bytes >= p.limits.osc_bytes_max
        act(p, AnsiIgnoredString, AnsiRefused(AnsiOscTooLong))
    else
        with_string(p, AnsiOscString, p.string_bytes + 1, 0, AnsiOscPut(b))

// Inside an OSC string.  Either terminator ends it and the one that
// did is reported; a stray ESC that is not followed by a backslash is
// dropped and the byte after it is payload, which is what xterm does.
fn osc_string(p: AnsiParser, b: Int) -> AnsiStep
    if p.utf8_owed == 1
        if b == 0x5C
            cleared(p, AnsiGround, AnsiOscEnd(AnsiStTerminated))
        else
            osc_payload(AnsiParser { state: AnsiOscString, limits: p.limits,
                                     values: p.values, groups: p.groups,
                                     intermediates: p.intermediates,
                                     private_marker: p.private_marker,
                                     string_bytes: p.string_bytes, utf8_value: 0,
                                     utf8_owed: 0 },
                                     b)
    else if b == 0x07
        cleared(p, AnsiGround, AnsiOscEnd(AnsiBelTerminated))
    else if b == 0x1B
        with_string(p, AnsiOscString, p.string_bytes, 1, AnsiNothing)
    else
        osc_payload(p, b)

// A DCS's parameter list, which has a CSI's shape exactly.
fn dcs_param(p: AnsiParser, b: Int) -> AnsiStep
    if b >= 0x30 and b <= 0x39
        param_digit(p, AnsiDcsParam, b - 0x30)
    else if b == 0x3B
        param_next_group(p, AnsiDcsParam)
    else if b == 0x3A
        param_next_sub(p, AnsiDcsParam)
    else if b >= 0x3C and b <= 0x3F
        with_marker(p, b)
    else if b >= 0x20 and b <= 0x2F
        collect_intermediate(p, AnsiDcsParam, b)
    else if b >= 0x40 and b <= 0x7E
        with_string(p, AnsiDcsPassthrough, 0, 0, AnsiDcsStart(b))
    else if b == 0x1B
        cleared(p, AnsiEscape, AnsiNothing)
    else
        act(p, AnsiDcsParam, AnsiNothing)

// One byte of a DCS payload, against the ceiling.
fn dcs_payload(p: AnsiParser, b: Int) -> AnsiStep
    if p.string_bytes >= p.limits.dcs_bytes_max
        act(p, AnsiIgnoredString, AnsiRefused(AnsiDcsTooLong))
    else
        with_string(p, AnsiDcsPassthrough, p.string_bytes + 1, 0, AnsiDcsPut(b))

// Inside a DCS payload.
fn dcs_passthrough(p: AnsiParser, b: Int) -> AnsiStep
    if p.utf8_owed == 1
        if b == 0x5C
            cleared(p, AnsiGround, AnsiDcsEnd(AnsiStTerminated))
        else
            dcs_payload(AnsiParser { state: AnsiDcsPassthrough, limits: p.limits,
                                     values: p.values, groups: p.groups,
                                     intermediates: p.intermediates,
                                     private_marker: p.private_marker,
                                     string_bytes: p.string_bytes, utf8_value: 0,
                                     utf8_owed: 0 },
                                     b)
    else if b == 0x07
        cleared(p, AnsiGround, AnsiDcsEnd(AnsiBelTerminated))
    else if b == 0x1B
        with_string(p, AnsiDcsPassthrough, p.string_bytes, 1, AnsiNothing)
    else
        dcs_payload(p, b)

// SOS, PM and APC — and the tail of a string that broke its ceiling.
// Consumed and never reported, so that a payload cannot reach the
// ground state and be re-read as text.
fn ignored_string(p: AnsiParser, b: Int) -> AnsiStep
    if p.utf8_owed == 1
        if b == 0x5C
            cleared(p, AnsiGround, AnsiNothing)
        else
            with_string(p, AnsiIgnoredString, p.string_bytes, 0, AnsiNothing)
    else if b == 0x07
        cleared(p, AnsiGround, AnsiNothing)
    else if b == 0x1B
        with_string(p, AnsiIgnoredString, p.string_bytes, 1, AnsiNothing)
    else
        act(p, AnsiIgnoredString, AnsiNothing)

// Whether an action is the one `feed` leaves out of its list.
fn is_nothing(a: AnsiAction) -> Bool
    match a
        AnsiNothing => true
        _           => false

// default_limits is what a terminal emulator on a machine with memory
// wants: 32 parameters, 6 sub-parameters, values to 65535, 2
// intermediates, and payloads to 4096 bytes.
pub fn default_limits() -> AnsiLimits
    AnsiLimits { params_max: 32, subs_max: 6, param_max: 65535, intermediates_max: 2,
                 osc_bytes_max: 4096, dcs_bytes_max: 4096 }

// strict_limits is what a device with kilobytes wants: 8 parameters,
// 4 sub-parameters, values to 4095, 2 intermediates, and payloads to
// 128 bytes.
//
// The payload ceilings are the ones that matter: an OSC 52 paste from
// a hostile peer is unbounded, and on a serial console there is
// nowhere to put it.
pub fn strict_limits() -> AnsiLimits
    AnsiLimits { params_max: 8, subs_max: 4, param_max: 4095, intermediates_max: 2,
                 osc_bytes_max: 128, dcs_bytes_max: 128 }

// parser_new is a parser in the ground state with `default_limits`.
pub fn parser_new() -> AnsiParser
    parser_with(default_limits())

// parser_with is a parser in the ground state with the limits given.
pub fn parser_with(limits: AnsiLimits) -> AnsiParser
    AnsiParser { state: AnsiGround, limits: limits, values: [], groups: [],
                 intermediates: [], private_marker: NO_PRIVATE_MARKER, string_bytes: 0,
                 utf8_value: 0, utf8_owed: 0 }

// feed_byte advances the machine by one byte and says what to do about
// it.
//
// This is the entry point everything else is written over, and the only
// one that allocates nothing per byte.  A chunk boundary anywhere is an
// ordinary rest position: feed the last byte of one read, keep the
// parser, feed the first byte of the next.
//
// ```novo
// use std.str
// use vtparse
//
// fn main() [io]
//     let p = vtparse.parser_new()
//     let step = vtparse.feed_byte(p, 0x41)
//     match step.action
//         AnsiPrint(ch) => println(str.from_int(ch))
//         _             => println("not a printable")
// ```
pub fn feed_byte(p: AnsiParser, b: Int) -> AnsiStep
    match p.state
        AnsiGround             => ground(p, b)
        AnsiEscape             => escape(p, b)
        AnsiEscapeIntermediate => escape_intermediate(p, b)
        AnsiCsiEntry           => csi_entry(p, b)
        AnsiCsiParam           => csi_param(p, b)
        AnsiCsiIntermediate    => csi_intermediate(p, b)
        AnsiCsiIgnore          => csi_ignore(p, b)
        AnsiOscString          => osc_string(p, b)
        AnsiDcsParam           => dcs_param(p, b)
        AnsiDcsPassthrough     => dcs_passthrough(p, b)
        AnsiIgnoredString      => ignored_string(p, b)
        AnsiUtf8Continuation   => utf8_continuation(p, b)

// feed advances the machine over a whole chunk, pairing every action
// with the parameters it fired with.
//
// The convenience over `feed_byte`, and it costs what the pairing
// costs: one `AnsiParams` copied per dispatch.  A caller that cannot
// pay that — a device, or anything on a hot path — feeds bytes.
pub fn feed(p: AnsiParser, chunk: [u8]) -> AnsiDrained
    var q = p
    var calls: [AnsiCall] = []
    for b in chunk
        let s = feed_byte(q, b as Int)
        q = s.parser
        if is_nothing(s.action) == false
            calls = list.push(calls, AnsiCall { action: s.action, params: params_of(q) })
    AnsiDrained { parser: q, calls: calls }

// reset puts the machine back in the ground state and forgets every
// partial sequence.
//
// What a program calls after it has written `ESC c` (RIS), or after it
// has taken a stream over from somewhere it does not trust.
pub fn reset(p: AnsiParser) -> AnsiParser
    cleared(p, AnsiGround, AnsiNothing).parser

// state_of is where the machine is resting.
pub fn state_of(p: AnsiParser) -> AnsiState
    p.state

// is_settled says whether the machine is in the ground state — the one
// state in which injecting bytes into the stream is safe.
pub fn is_settled(p: AnsiParser) -> Bool
    match p.state
        AnsiGround => true
        _          => false

// param_count is how many parameters the last dispatch came with,
// counting a colon group as one.
pub fn param_count(p: AnsiParser) -> Int
    count_of(p.groups)

// param_at is parameter `i`, with `fallback` for one that is absent or
// empty.
//
// The fallback is a parameter rather than a fixed zero because ECMA-48
// gives different defaults to different sequences: CUU's omitted
// parameter means 1, ED's means 0, and a caller that hard-coded either
// would be wrong half the time.
pub fn param_at(p: AnsiParser, i: Int, fallback: Int) -> Int
    at_of(p.values, p.groups, i, fallback)

// sub_count is how many sub-parameters parameter `i` has, counting
// itself: 1 for a plain parameter, 6 for `38:2::1:2:3`.
pub fn sub_count(p: AnsiParser, i: Int) -> Int
    sub_count_of(p.groups, i)

// sub_at is sub-parameter `j` of parameter `i`, with `fallback` for
// one that is absent or empty — the empty middle slot of
// `38:2::1:2:3` being the case that matters.
pub fn sub_at(p: AnsiParser, i: Int, j: Int, fallback: Int) -> Int
    sub_at_of(p.values, p.groups, i, j, fallback)

// intermediate_count is how many intermediate bytes the last dispatch
// came with.
pub fn intermediate_count(p: AnsiParser) -> Int
    list.len(p.intermediates)

// intermediate_at is intermediate byte `i`, or 0 past the end.
pub fn intermediate_at(p: AnsiParser, i: Int) -> Int
    if i < 0 or i >= list.len(p.intermediates)
        0
    else
        list.get(p.intermediates, i)

// private_marker_of is the byte that opened a private sequence — `?`
// for the DEC modes, `<`, `=` or `>` for the others — or
// `NO_PRIVATE_MARKER`.
//
// Kept apart from the intermediates because `CSI ? 1049 h` and
// `CSI 1049 h` are different sequences, and a parser that folded the
// two would switch to the alternate screen when asked to set insert
// mode.
pub fn private_marker_of(p: AnsiParser) -> Int
    p.private_marker

// params_of copies everything the last dispatch came with into one
// value.
//
// Allocates, which is why the byte path does not use it.  It is how a
// caller hands a whole parameter list to `sgr.apply_sgr`, and what
// `feed` pairs with each action.
pub fn params_of(p: AnsiParser) -> AnsiParams
    AnsiParams { values: p.values, groups: p.groups,
                 intermediates: p.intermediates, private_marker: p.private_marker }

// params_empty is a snapshot with no parameters, no intermediates and
// no private marker.
pub fn params_empty() -> AnsiParams
    AnsiParams { values: [], groups: [], intermediates: [],
                 private_marker: NO_PRIVATE_MARKER }

// params_count is how many parameters a snapshot holds.
pub fn params_count(ps: AnsiParams) -> Int
    count_of(ps.groups)

// params_at is parameter `i` of a snapshot, with `fallback` for one
// that is absent or empty.
pub fn params_at(ps: AnsiParams, i: Int, fallback: Int) -> Int
    at_of(ps.values, ps.groups, i, fallback)

// params_sub_count is how many sub-parameters parameter `i` of a
// snapshot has, counting itself.
pub fn params_sub_count(ps: AnsiParams, i: Int) -> Int
    sub_count_of(ps.groups, i)

// params_sub_at is sub-parameter `j` of parameter `i` of a snapshot,
// with `fallback` for one that is absent or empty.
pub fn params_sub_at(ps: AnsiParams, i: Int, j: Int, fallback: Int) -> Int
    sub_at_of(ps.values, ps.groups, i, j, fallback)

// osc_code reads the numeric code off an accumulated OSC payload — the
// digits before the first semicolon.
//
// `None` when the payload does not begin with digits, which is what an
// OSC the caller should ignore looks like.  The parser does not hold
// the payload, so the caller passes the bytes it accumulated from
// `AnsiOscPut`.
pub fn osc_code(payload: [u8]) -> ?Int
    var code = 0
    var seen = false
    var stop = false
    for k in 0..list.len(payload)
        if stop == false
            let c = list.get(payload, k) as Int
            if c >= 0x30 and c <= 0x39
                code = code * 10 + (c - 0x30)
                seen = true
            else
                stop = true
    if seen
        Some(code)
    else
        None

// osc_field is field `n` of an accumulated OSC payload, counting the
// code as field 0 and splitting on semicolons.
//
// `None` past the end.  OSC 52's payload is `52;c;<base64>`, so the
// selection is field 1 and the data field 2 — and the last field is
// returned whole rather than split further, because a base64 payload
// may legitimately contain nothing this function would split on.
pub fn osc_field(payload: [u8], n: Int) -> ?[u8]
    let n_bytes = list.len(payload)
    var field = 0
    var start = 0
    var from = 0 - 1
    var upto = 0 - 1
    for k in 0..n_bytes
        if (list.get(payload, k) as Int) == 0x3B
            if field == n and from < 0
                from = start
                upto = k
            field = field + 1
            start = k + 1
    if from < 0 and field == n
        from = start
        upto = n_bytes
    if from < 0
        None
    else
        Some(list.slice(payload, from, upto))
