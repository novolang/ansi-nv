// vtparse.nv — the state machine of `vtcore`, with its integers turned
// into enums for a program on a host.
//
// `vtcore` is the machine.  It speaks integers alone, because an enum
// is a tagged value and a list literal is a heap allocation, and an
// `@tier(embedded)` function may have neither.  This module is the same
// machine for a caller with a heap: `action_of` answers an
// `AnsiAction`, `state_of` answers an `AnsiState`, and `params_of`
// copies a dispatch's numbers into one value that can outlive the
// parser.
//
// The parser itself is `vtcore.AnsiParser`, and it is passed to and
// from this module unchanged.  `feed` here and `vtcore.feed` are the
// same function, so a program may read the action as an enum on one
// byte and as an integer on the next.
//
// ```novo
// use std.str
// use vtparse
//
// fn main() [io]
//     var p = vtparse.parser_new()
//     for b in [0x1B, 0x5B, 0x32, 0x3B, 0x31, 0x48]
//         p = vtparse.feed(p, b)
//         match vtparse.action_of(p)
//             AnsiCsiDispatch(_) =>
//                 // CUP: row 2, column 1, and the parameters are still
//                 // readable off the parser the dispatch came with.
//                 println(str.from_int(vtparse.param_at(p, 0, 1)))
//                 println(str.from_int(vtparse.param_at(p, 1, 1)))
//             _ => println("consumed")
// ```

use vtcore

// AnsiState is where the machine is resting between bytes.
//
// It is `pub` because a caller sometimes has to reason about a partial
// read.  A proxy deciding whether it is safe to inject a sequence and a
// test asserting that a chunk boundary left nothing behind both need to
// ask.  `AnsiGround` is the only state in which injecting bytes into
// the stream is safe.
pub enum AnsiState
    // Between sequences.  The next byte is text, a C0 control, or the
    // ESC that starts one.
    AnsiGround
    // ESC has arrived and the next byte decides what kind of sequence
    // this is.
    AnsiEscape
    // ESC with intermediates collected, waiting for the final byte.
    AnsiEscapeIntermediate
    // CSI has arrived and no parameter byte has been seen yet, so the
    // next byte may still be the private marker.
    AnsiCsiEntry
    // Inside a CSI's parameter list, collecting digits, semicolons and
    // colons.
    AnsiCsiParam
    // Inside a CSI, past the parameters, collecting intermediates.
    AnsiCsiIntermediate
    // Inside a CSI that has already broken a rule.  It had too many
    // parameters, a parameter too large, or an intermediate before the
    // private marker.  The bytes are consumed to the final byte and the
    // sequence is dropped rather than half-applied.
    AnsiCsiIgnore
    // Inside an OSC string, and every payload byte is coming out as
    // `AnsiOscPut`.
    AnsiOscString
    // Inside a DCS's parameter list.
    AnsiDcsParam
    // Inside a DCS's payload, and every byte is coming out as
    // `AnsiDcsPut`.
    AnsiDcsPassthrough
    // Inside SOS, PM or APC.  Each is a string this package consumes
    // and does not report, so that its payload cannot leak back into
    // the ground state and be re-parsed as text.
    AnsiIgnoredString
    // Part-way through a multi-byte UTF-8 codepoint, waiting for
    // continuation bytes.
    AnsiUtf8Continuation

// AnsiTerminator is which of the two endings an OSC or DCS string
// actually used.
//
// It is reported rather than normalised, because the answer decides
// what a program echoes back.  A terminal that was asked with BEL is
// answered with BEL, and xterm's own OSC 52 handling is the case that
// made this worth a variant instead of a `Bool`.
pub enum AnsiTerminator
    // BEL, 0x07.  xterm's original, and still what most programs send.
    AnsiBelTerminated
    // ST, ESC backslash.  The form ECMA-48 defines.
    AnsiStTerminated

// AnsiFault is a rule the incoming bytes broke.
//
// A fault is reported and the sequence is dropped.  The machine never
// stops, because a terminal that stopped parsing on a malformed
// sequence would be a terminal one bad byte could wedge.  Every fault
// names a limit rather than a syntax error, because the syntax has no
// errors.  An unrecognised final byte is a sequence for a feature this
// package does not cover, not a mistake.
pub enum AnsiFault
    // More parameters than `AnsiLimits.params_max`, or more entries
    // than `vtcore.ENTRY_CAP`.
    AnsiTooManyParams
    // More sub-parameters in one group than `AnsiLimits.subs_max`.
    AnsiTooManySubParams
    // A parameter's digits ran past `AnsiLimits.param_max`.
    AnsiParamTooLarge
    // More intermediate bytes than `AnsiLimits.intermediates_max`.
    AnsiTooManyIntermediates
    // An OSC payload ran past `AnsiLimits.osc_bytes_max`.  The bytes
    // already reported stand, the rest of the payload is dropped, and
    // `AnsiOscEnd` still fires when the string ends.
    AnsiOscTooLong
    // A DCS payload ran past `AnsiLimits.dcs_bytes_max`, on the same
    // terms.
    AnsiDcsTooLong
    // A UTF-8 sequence that is not one.  It is a continuation byte in
    // the ground state, a lead byte that promises more bytes than
    // arrived, an overlong form, or a surrogate.
    // `vtcore.REPLACEMENT_CHAR` is what the caller prints in its place.
    AnsiBadUtf8

// AnsiAction is one thing the caller has to do about one byte.
//
// It is deliberately small.  At most one integer, no lists, and nothing
// borrowed from the parser.  Everything a dispatch needs beyond its
// final byte is read off the parser the byte was fed to.  That is the
// parameters, their sub-parameters, the intermediates and the private
// marker.
pub enum AnsiAction
    // The byte was consumed and there is nothing to do.  A digit inside
    // a parameter list, a continuation byte part-way through a
    // codepoint and the `[` after an ESC all arrive this way.
    AnsiNothing
    // A whole codepoint to put on the screen.  Combining marks and wide
    // characters arrive as themselves.  How many cells one takes is the
    // caller's question, and textwrap-nv is where the answer lives.
    AnsiPrint(ch: Int)
    // A C0 control that acts on its own, such as BS, HT, LF, VT, FF, CR
    // and BEL.  A byte at 0x80 or above is a UTF-8 lead byte rather
    // than a C1 control, so the 8-bit forms do not arrive here.
    AnsiExecute(control: Int)
    // ESC <intermediates> <final>.  DECSC (`ESC 7`), DECRC (`ESC 8`),
    // IND, NEL, RI, RIS, and the charset designators.
    AnsiEscDispatch(final_byte: Int)
    // CSI <private> <params> <intermediates> <final>.  The whole of
    // cursor movement, erasing, scrolling, SGR, the mode sets and the
    // queries.
    AnsiCsiDispatch(final_byte: Int)
    // An OSC string is starting.  Its numeric code is not known yet,
    // because it arrives as the payload bytes before the first
    // semicolon.  A caller accumulates the payload and reads it with
    // `osc_code` once `AnsiOscEnd` has fired.
    AnsiOscStart
    // One byte of an OSC payload.  Reported a byte at a time so that an
    // OSC 52 clipboard payload of any length costs the parser nothing
    // to carry.
    AnsiOscPut(byte: Int)
    // The OSC string ended, and how.
    AnsiOscEnd(terminator: AnsiTerminator)
    // A DCS string is starting.  Its parameters and final byte are on
    // the parser, exactly as a CSI's are.
    AnsiDcsStart(final_byte: Int)
    // One byte of a DCS payload.
    AnsiDcsPut(byte: Int)
    // The DCS string ended, and how.
    AnsiDcsEnd(terminator: AnsiTerminator)
    // The incoming bytes broke a rule.  The sequence is dropped and the
    // machine carries on.
    AnsiRefused(why: AnsiFault)

// AnsiParams is a snapshot of everything a dispatch came with, as one
// value a caller may keep.
//
// The byte path does not need it, because `param_at` reads the parser
// directly and the parser is cheap to hold.  It exists for `drain`,
// which hands back a list of actions the caller will look at after the
// parser has moved on, and for `sgr.apply_sgr`, which wants the whole
// parameter list as one argument.
pub struct AnsiParams
    // One entry per parameter, in the order they arrived, with
    // `PARAM_EMPTY` for a parameter the sequence left empty.
    values: [Int]
    // The group each entry of `values` belongs to.  Colon-separated
    // sub-parameters share a group and semicolon-separated ones do not,
    // so `38:2::1:2:3;4` is groups `0 0 0 0 0 0` then `1`.
    groups: [Int]
    // The intermediate bytes, 0x20..0x2F, in order.
    intermediates: [Int]
    // The private marker, or `NO_PRIVATE_MARKER`.
    private_marker: Int

// AnsiCall is one action and the parameters it fired with.
//
// This is the pairing `drain` exists to make.  An action alone is not
// enough once the parser has moved past it, so the chunk path copies
// the numbers out at the moment of the dispatch.  That copy is the
// difference in cost between the two entry points, and it is what makes
// the byte path the cheaper one.
pub struct AnsiCall
    action: AnsiAction
    params: AnsiParams

// AnsiDrained is a whole chunk's worth of calls and the parser left
// over.
pub struct AnsiDrained
    parser: vtcore.AnsiParser
    calls: [AnsiCall]

// The fallback a caller passes to `param_at` to tell an absent
// parameter from a zero one, and what an empty slot of an `AnsiParams`
// snapshot holds.
pub const PARAM_EMPTY = 0 - 1

// What `private_marker_of` answers for a sequence that had no private
// marker.
pub const NO_PRIVATE_MARKER = 0

// The codepoint a caller substitutes after `AnsiBadUtf8`.  It is
// U+FFFD, the replacement character.
pub const REPLACEMENT_CHAR = 0xFFFD

// ── The integers, as enums ──────────────────────────────────────────

// The state an `ST_` code names.
fn state_of_code(c: Int) -> AnsiState
    if c == vtcore.ST_ESCAPE
        AnsiEscape
    else if c == vtcore.ST_ESCAPE_INTERMEDIATE
        AnsiEscapeIntermediate
    else if c == vtcore.ST_CSI_ENTRY
        AnsiCsiEntry
    else if c == vtcore.ST_CSI_PARAM
        AnsiCsiParam
    else if c == vtcore.ST_CSI_INTERMEDIATE
        AnsiCsiIntermediate
    else if c == vtcore.ST_CSI_IGNORE
        AnsiCsiIgnore
    else if c == vtcore.ST_OSC_STRING
        AnsiOscString
    else if c == vtcore.ST_DCS_PARAM
        AnsiDcsParam
    else if c == vtcore.ST_DCS_PASSTHROUGH
        AnsiDcsPassthrough
    else if c == vtcore.ST_IGNORED_STRING
        AnsiIgnoredString
    else if c == vtcore.ST_UTF8_CONTINUATION
        AnsiUtf8Continuation
    else
        AnsiGround

// The fault a `FAULT_` code names.
fn fault_of_code(c: Int) -> AnsiFault
    if c == vtcore.FAULT_TOO_MANY_SUB_PARAMS
        AnsiTooManySubParams
    else if c == vtcore.FAULT_PARAM_TOO_LARGE
        AnsiParamTooLarge
    else if c == vtcore.FAULT_TOO_MANY_INTERMEDIATES
        AnsiTooManyIntermediates
    else if c == vtcore.FAULT_OSC_TOO_LONG
        AnsiOscTooLong
    else if c == vtcore.FAULT_DCS_TOO_LONG
        AnsiDcsTooLong
    else if c == vtcore.FAULT_BAD_UTF8
        AnsiBadUtf8
    else
        AnsiTooManyParams

// The terminator a `TERM_` code names.
fn terminator_of_code(c: Int) -> AnsiTerminator
    if c == vtcore.TERM_ST
        AnsiStTerminated
    else
        AnsiBelTerminated

// ── Reading a snapshot ──────────────────────────────────────────────
//
// The four readers below are what `params_count` and its neighbours
// are.  They answer from the group list, so a snapshot and the parser
// it was copied from cannot come to different answers.

// How many parameters a group list describes.  A group number is
// assigned in order from 0, so the last one plus one is the count.
fn count_of(groups: [Int]) -> Int
    let n = list.len(groups)
    if n == 0
        0
    else
        list.get(groups, n - 1) + 1

// Where group `g` starts in the flat list, or -1 when there is no such
// group.
fn group_start(groups: [Int], g: Int) -> Int
    for k in 0..list.len(groups)
        if list.get(groups, k) == g
            return k
    0 - 1

// Parameter `i`, with `fallback` for absent and for empty alike.
fn at_of(values: [Int], groups: [Int], i: Int, fallback: Int) -> Int
    let k = group_start(groups, i)
    if k < 0
        fallback
    else
        let v = list.get(values, k)
        if v == PARAM_EMPTY
            fallback
        else
            v

// How many entries group `i` holds, counting the parameter itself.
fn sub_count_of(groups: [Int], i: Int) -> Int
    var n = 0
    for k in 0..list.len(groups)
        if list.get(groups, k) == i
            n = n + 1
    n

// Sub-parameter `j` of parameter `i`.
fn sub_at_of(values: [Int], groups: [Int], i: Int, j: Int, fallback: Int) -> Int
    let k = group_start(groups, i)
    if k < 0 or j < 0 or k + j >= list.len(groups)
        fallback
    else if list.get(groups, k + j) != i
        fallback
    else
        let v = list.get(values, k + j)
        if v == PARAM_EMPTY
            fallback
        else
            v

// Whether an action is the one `drain` leaves out of its list.
fn is_nothing(a: AnsiAction) -> Bool
    match a
        AnsiNothing => true
        _           => false

// ── The parser, for a caller with a heap ────────────────────────────

// default_limits is `vtcore.default_limits`: 16 parameters, 6
// sub-parameters, values to 65534, 2 intermediates and payloads to 4096
// bytes.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     println("${vtparse.default_limits().params_max as Int}")   // 16
// ```
pub fn default_limits() -> vtcore.AnsiLimits
    vtcore.default_limits()

// strict_limits is `vtcore.strict_limits`: 8 parameters, 4
// sub-parameters, values to 4095, 2 intermediates and payloads to 128
// bytes.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     println("${vtparse.strict_limits().params_max as Int}")   // 8
// ```
pub fn strict_limits() -> vtcore.AnsiLimits
    vtcore.strict_limits()

// parser_new is a parser in the ground state with `default_limits`.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     println("${vtparse.is_settled(vtparse.parser_new())}")   // true
// ```
pub fn parser_new() -> vtcore.AnsiParser
    vtcore.parser_new()

// parser_with is a parser in the ground state with the limits given,
// each held to the package's own capacity.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     let p = vtparse.parser_with(vtparse.strict_limits())
//     println("${vtparse.limits_of(p).subs_max as Int}")   // 4
// ```
pub fn parser_with(limits: vtcore.AnsiLimits) -> vtcore.AnsiParser
    vtcore.parser_with(limits)

// feed advances the machine by one byte and answers the parser after
// it.
//
// This is the entry point everything else is written over.  It copies
// no parameter list and allocates nothing.  What the byte asked for is
// read off the parser with `action_of`, and so are the numbers a
// dispatch came with.  A chunk boundary anywhere is an ordinary rest
// position: feed the last byte of one read, keep the parser, and feed
// it the first byte of the next.
//
// ```novo
// use std.str
// use vtparse
//
// fn main() [io]
//     let p = vtparse.feed(vtparse.parser_new(), 0x41)
//     match vtparse.action_of(p)
//         AnsiPrint(ch) => println(str.from_int(ch))
//         _             => println("not a printable")
// ```
pub fn feed(p: vtcore.AnsiParser, b: Int) -> vtcore.AnsiParser
    vtcore.feed(p, b)

// action_of is what the last byte fed asked the caller to do.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     let p = vtparse.feed(vtparse.parser_new(), 0x0A)
//     match vtparse.action_of(p)
//         AnsiExecute(c) => println("${c}")   // 10
//         _              => println("no")
// ```
pub fn action_of(p: vtcore.AnsiParser) -> AnsiAction
    let k = vtcore.action_kind(p)
    let a = vtcore.action_arg(p)
    if k == vtcore.ACT_PRINT
        AnsiPrint(a)
    else if k == vtcore.ACT_EXECUTE
        AnsiExecute(a)
    else if k == vtcore.ACT_ESC_DISPATCH
        AnsiEscDispatch(a)
    else if k == vtcore.ACT_CSI_DISPATCH
        AnsiCsiDispatch(a)
    else if k == vtcore.ACT_OSC_START
        AnsiOscStart
    else if k == vtcore.ACT_OSC_PUT
        AnsiOscPut(a)
    else if k == vtcore.ACT_OSC_END
        AnsiOscEnd(terminator_of_code(a))
    else if k == vtcore.ACT_DCS_START
        AnsiDcsStart(a)
    else if k == vtcore.ACT_DCS_PUT
        AnsiDcsPut(a)
    else if k == vtcore.ACT_DCS_END
        AnsiDcsEnd(terminator_of_code(a))
    else if k == vtcore.ACT_REFUSED
        AnsiRefused(fault_of_code(a))
    else
        AnsiNothing

// drain advances the machine over a whole chunk, pairing every action
// with the parameters it fired with.
//
// The convenience over `feed`, and it costs what the pairing costs,
// which is one `AnsiParams` copied per action.  A caller that cannot
// pay that feeds bytes instead.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     let d = vtparse.drain(vtparse.parser_new(), [0x41 as u8, 0x42 as u8])
//     println("${list.len(d.calls)}")   // 2
// ```
pub fn drain(p: vtcore.AnsiParser, chunk: [u8]) -> AnsiDrained
    var q = p
    var calls: [AnsiCall] = []
    for b in chunk
        q = vtcore.feed(q, b as Int)
        let a = action_of(q)
        if is_nothing(a) == false
            calls = list.push(calls, AnsiCall { action: a, params: params_of(q) })
    AnsiDrained { parser: q, calls: calls }

// reset puts the machine back in the ground state and forgets every
// partial sequence.
//
// What a program calls after it has written `ESC c` (RIS), or after it
// has taken a stream over from somewhere it does not trust.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     let p = vtparse.feed(vtparse.parser_new(), 0x1B)
//     println("${vtparse.is_settled(vtparse.reset(p))}")   // true
// ```
pub fn reset(p: vtcore.AnsiParser) -> vtcore.AnsiParser
    vtcore.reset(p)

// state_of is where the machine is resting.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     match vtparse.state_of(vtparse.parser_new())
//         AnsiGround => println("ground")
//         _          => println("elsewhere")
// ```
pub fn state_of(p: vtcore.AnsiParser) -> AnsiState
    state_of_code(vtcore.state_code(p))

// is_settled says whether the machine is in the ground state, which is
// the one state where injecting bytes into the stream is safe.
pub fn is_settled(p: vtcore.AnsiParser) -> Bool
    vtcore.is_settled(p)

// limits_of is the ceilings the parser is enforcing, after
// `parser_with` held each one to the package's capacity.
pub fn limits_of(p: vtcore.AnsiParser) -> vtcore.AnsiLimits
    vtcore.limits_of(p)

// param_count is how many parameters the last dispatch came with,
// counting a colon group as one.
pub fn param_count(p: vtcore.AnsiParser) -> Int
    vtcore.param_count(p)

// param_at is parameter `i`, with `fallback` for one that is absent or
// empty.
//
// The fallback is a parameter rather than a fixed zero, because ECMA-48
// gives different defaults to different sequences.  CUU's omitted
// parameter means 1 and ED's means 0, so a caller that hard-coded
// either would be wrong half the time.
pub fn param_at(p: vtcore.AnsiParser, i: Int, fallback: Int) -> Int
    vtcore.param_at(p, i, fallback)

// sub_count is how many sub-parameters parameter `i` has, counting
// itself.  It is 1 for a plain parameter and 6 for `38:2::1:2:3`.
pub fn sub_count(p: vtcore.AnsiParser, i: Int) -> Int
    vtcore.sub_count(p, i)

// sub_at is sub-parameter `j` of parameter `i`, with `fallback` for one
// that is absent or empty.  The empty middle slot of `38:2::1:2:3` is
// the case that matters.
pub fn sub_at(p: vtcore.AnsiParser, i: Int, j: Int, fallback: Int) -> Int
    vtcore.sub_at(p, i, j, fallback)

// intermediate_count is how many intermediate bytes the last dispatch
// came with.
pub fn intermediate_count(p: vtcore.AnsiParser) -> Int
    vtcore.intermediate_count(p)

// intermediate_at is intermediate byte `i`, or 0 past the end.
pub fn intermediate_at(p: vtcore.AnsiParser, i: Int) -> Int
    vtcore.intermediate_at(p, i)

// private_marker_of is the byte that opened a private sequence, or
// `NO_PRIVATE_MARKER` when the sequence had none.  It is `?` for the DEC
// modes, and `<`, `=` or `>` for the others.
//
// It is kept apart from the intermediates because `CSI ? 1049 h` and
// `CSI 1049 h` are different sequences.  A parser that folded the two
// would switch to the alternate screen when asked to set insert mode.
pub fn private_marker_of(p: vtcore.AnsiParser) -> Int
    vtcore.private_marker_of(p)

// ── A snapshot of a dispatch ────────────────────────────────────────

// params_of copies everything the last dispatch came with into one
// value.
//
// It builds three lists, which is why the byte path does not use it.
// It is how a caller hands a whole parameter list to `sgr.apply_sgr`,
// and what `drain` pairs with each action.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     var p = vtparse.parser_new()
//     for b in [0x1B, 0x5B, 0x34, 0x6D]
//         p = vtparse.feed(p, b)
//     println("${vtparse.params_at(vtparse.params_of(p), 0, 0)}")   // 4
// ```
pub fn params_of(p: vtcore.AnsiParser) -> AnsiParams
    var values: [Int] = []
    var groups: [Int] = []
    for i in 0..vtcore.param_count(p)
        for j in 0..vtcore.sub_count(p, i)
            values = list.push(values, vtcore.sub_at(p, i, j, PARAM_EMPTY))
            groups = list.push(groups, i)
    // An explicit loop rather than `list.map` over `list.range`,
    // because `list.range` is refused for wasm and this package builds
    // there.
    var inter: [Int] = []
    for k in 0..vtcore.intermediate_count(p)
        let b = vtcore.intermediate_at(p, k)
        inter = list.push(inter, b)
    AnsiParams { values: values, groups: groups, intermediates: inter,
                 private_marker: vtcore.private_marker_of(p) }

// params_empty is a snapshot with no parameters, no intermediates and
// no private marker.
pub fn params_empty() -> AnsiParams
    AnsiParams { values: [], groups: [], intermediates: [],
                 private_marker: NO_PRIVATE_MARKER }

// params_count is how many parameters a snapshot holds.
pub fn params_count(ps: AnsiParams) -> Int
    count_of(ps.groups)

// params_at is parameter `i` of a snapshot, with `fallback` for one
// that is absent or empty.
pub fn params_at(ps: AnsiParams, i: Int, fallback: Int) -> Int
    at_of(ps.values, ps.groups, i, fallback)

// params_sub_count is how many sub-parameters parameter `i` of a
// snapshot has, counting itself.
pub fn params_sub_count(ps: AnsiParams, i: Int) -> Int
    sub_count_of(ps.groups, i)

// params_sub_at is sub-parameter `j` of parameter `i` of a snapshot,
// with `fallback` for one that is absent or empty.
pub fn params_sub_at(ps: AnsiParams, i: Int, j: Int, fallback: Int) -> Int
    sub_at_of(ps.values, ps.groups, i, j, fallback)

// ── Reading an accumulated OSC payload ──────────────────────────────
//
// The parser does not hold the payload.  A caller accumulates the bytes
// reported by `AnsiOscPut` in a buffer of its own, and the three
// functions below read that buffer once `AnsiOscEnd` has fired.

// osc_code reads the numeric code off an accumulated OSC payload, which
// is the digits before the first semicolon.
//
// `None` when the payload does not begin with digits, which is what an
// OSC the caller should ignore looks like.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     match vtparse.osc_code([0x35 as u8, 0x32 as u8, 0x3B as u8, 0x63 as u8])
//         Some(n) => println("${n}")   // 52
//         None    => println("none")
// ```
pub fn osc_code(payload: [u8]) -> ?Int
    var code = 0
    var seen = false
    var stop = false
    for k in 0..list.len(payload)
        if stop == false
            let c = list.get(payload, k) as Int
            if c >= 0x30 and c <= 0x39
                code = code * 10 + (c - 0x30)
                seen = true
            else
                stop = true
    if seen
        Some(code)
    else
        None

// osc_field is field `n` of an accumulated OSC payload, counting the
// code as field 0 and splitting on semicolons.
//
// `None` past the end.  OSC 52's payload is `52;c;<base64>`, so the
// selection is field 1 and the data is field 2.  The last field is
// returned whole rather than split further, because a base64 payload
// may legitimately contain nothing this function would split on.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     match vtparse.osc_field([0x30 as u8, 0x3B as u8, 0x68 as u8], 1)
//         Some(f) => println("${list.len(f)}")   // 1
//         None    => println("none")
// ```
pub fn osc_field(payload: [u8], n: Int) -> ?[u8]
    let n_bytes = list.len(payload)
    var field = 0
    var start = 0
    var from = 0 - 1
    var upto = 0 - 1
    for k in 0..n_bytes
        if (list.get(payload, k) as Int) == 0x3B
            if field == n and from < 0
                from = start
                upto = k
            field = field + 1
            start = k + 1
    if from < 0 and field == n
        from = start
        upto = n_bytes
    if from < 0
        None
    else
        Some(list.slice(payload, from, upto))

// osc_body is everything after the first semicolon of an accumulated
// OSC payload, and `None` when the payload has no semicolon.
//
// The code and the body are what almost every OSC is.  `OSC 0 ; <text>`
// sets the window title and `OSC 8 ; <params> ; <uri>` opens a
// hyperlink, and in both the caller wants the code through `osc_code`
// and the rest whole.  A body with semicolons of its own comes back
// with them, which `osc_field` would have split.
//
// ```novo
// use vtparse
//
// fn main() [io]
//     match vtparse.osc_body([0x30 as u8, 0x3B as u8, 0x68 as u8, 0x69 as u8])
//         Some(b) => println("${list.len(b)}")   // 2
//         None    => println("none")
// ```
pub fn osc_body(payload: [u8]) -> ?[u8]
    let n_bytes = list.len(payload)
    for k in 0..n_bytes
        if (list.get(payload, k) as Int) == 0x3B
            return Some(list.slice(payload, k + 1, n_bytes))
    None
